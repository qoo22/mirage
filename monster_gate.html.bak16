function curJobLock(){ return G.campaign===2 ? G.story2Job : G.storyJob; }
function setJobLock(j){ if(G.campaign===2) G.story2Job=j; else G.storyJob=j; }
// 物語開始時に職業を1回だけ選ばせる（以後固定）
function jobSelect(cb){
  G._jobSelCb=cb;
  document.body.classList.remove('setupbg');
  document.getElementById('modePick').classList.add('hidden');
  document.getElementById('freeSetup').classList.remove('hidden');
  document.getElementById('storyDunNote').classList.remove('hidden');
  document.getElementById('storyDunNote').textContent='あなたは何者か——職業を選ぶ（物語では変更できません）';
  document.querySelector('.step[data-s="1"]').classList.add('hidden');
  document.querySelector('.step[data-s="0"]').classList.remove('hidden');
  const b0=document.getElementById('back0'); if(b0) b0.style.display='none';
  showStep(0);
}
// 称号
const TITLES=[
 {id:'clearTrue', nm:'🏆 願いを置いた者', desc:'TRUE END到達'},
 {id:'clearNormal', nm:'🎖 世界を救った者', desc:'NORMAL END到達'},
 {id:'noForbidden', nm:'🕊 禁忌に触れぬ者', desc:'禁忌カードを一度も使わずクリア'},
 {id:'allBoss', nm:'📚 ボスカード収集者', desc:'全ボスカードを集めた'},
 {id:'shardLord', nm:'🔹 記憶の蒐集家', desc:'記憶片を20以上集めた'},
 {id:'licensed', nm:'🪪 公認探索者', desc:'第2部で探索者ライセンスを取得'},
 {id:'clear2Normal', nm:'🗝 門を閉ざした者', desc:'第2部 NORMAL END到達'},
 {id:'clear2True', nm:'🎴 カードを置く者', desc:'第2部 TRUE END到達'},
 {id:'worldKing', nm:'👑 世界の覇者', desc:'ワールドモードでGREAT城を制圧'},
];
function earnTitle(id){ G.titles=G.titles||{}; if(!G.titles[id]){ G.titles[id]=true; saveStory();
  const t=TITLES.find(x=>x.id===id); if(t) log(`称号獲得: ${t.nm}`,"l-gold"); } }

// 第1部シナリオのバージョン（旧セーブは序章から開始させ、新シナリオを最初から見せる）
const STORY_VER=2;
// ---- ビジュアルノベル会話 ----
let _cs=null;
// 会話の背景キー（章/場面に応じて切替）
function vnBgKey(){
  if(!G.storyMode) return 'op_gate';
  const ch=curChapter(); if(!ch) return 'op_gate';
  if(G.campaign===2) return ch.scene || 'op_gate';
  return ch.key==='final' ? 'bg_final' : ('bg_ch'+(G.storyChapter+1));
}
// 立ち絵の候補URL（ローカル→VNリモート→ベース立ち絵）。emojiはフォールバック表示。
function heroPortrait(expr){
  const j=G.job||'warrior';
  return [`assets/h_${j}_${expr}.png`, `assets/h_${j}_neutral.png`, HERO_SPRITE[j]||''].filter(Boolean);
}
const EXALIAS={ mia:'mina' }; // 表情セットの流用（ミア＝ミアの表情）
// 章ごとのボス立ち絵（汎用bossキーの台詞を、章のボス画像で表示）。e8はアルゼンの立ち絵に接続。
const BOSS_IMG={ ch1:'boss_ch1',ch2:'boss_ch2',ch3:'boss_ch3',ch4:'boss_ch4',ch5:'boss_ch5',ch7:'boss_ch7',ch8:'boss_ch8',
  e1:'boss_e1',e2:'boss_e2',e5:'boss_e5',e6:'boss_e6',e8:'t_char_arzen', final:'boss_final',efinal:'boss_final' };
function bossPortraitList(){ const ch=(typeof curChapter==='function')&&curChapter(); const k=ch&&BOSS_IMG[ch.key];
  return k?['assets/'+k+'.png']:(PORT.boss.img?[PORT.boss.img]:[]); }
function partnerPortrait(who,expr){
  // ピコは表情で絵が変わると別人に見えるので、1枚に固定
  if(who==='pico'){ return ['assets/e_pico.png', 'assets/e_pico_neutral.png']; }
  const ex=EXALIAS[who]||who;
  const list=[];
  list.push(`assets/e_${ex}_${expr}.png`, `assets/e_${ex}_neutral.png`);
  const p=PORT[who]; if(p&&p.img) list.push(p.img);
  return list;
}
// 候補を順に試し、全滅したらemojiを出す
function setSide(imgEl, emoEl, candidates, emoji){
  emoEl.textContent=emoji||'';
  let i=0;
  imgEl.onload=()=>{ imgEl.style.display=''; emoEl.style.display='none'; };
  imgEl.onerror=()=>{ i++; if(i<candidates.length){ imgEl.src=candidates[i]; }
    else { imgEl.onerror=null; imgEl.style.display='none'; emoEl.style.display=candidates._emoji?'':'none'; } };
  if(candidates.length){ candidates._emoji=!!emoji; imgEl.style.display='none'; emoEl.style.display=emoji?'':'none'; imgEl.src=candidates[0]; }
  else { imgEl.style.display='none'; emoEl.style.display=emoji?'':'none'; }
}
// 簡易表情推定（明示指定が無い行向け）
function autoExpr(who,text){
  if(/おめでとう|よかった|いいね|だね|っぽく|うん。そう/.test(text)) return who==='lily'?'smile':(who==='mina'?'smile':'neutral');
  if(/ごめん|救えなかっ|消え|ばいばい|さよ|もういい|泣/.test(text)) return who==='hero'?'worried':'sad';
  if(/！？|まさか|嘘|なんだと|……っ|なに[!！]/.test(text)) return who==='hero'?'shock':'worried';
  if(/だめ|危険|気をつけ|聞いちゃ|やめて|どうして/.test(text)) return 'worried';
  if(/[！]/.test(text)) return who==='hero'?'determined':(who==='lily'?'serious':(who==='boss'||who==='arzen'?'stern':'neutral'));
  return 'neutral';
}
/* ===== DialogueManager: ドラクエ風ボックス × Undertale風（タイプ表示・声・ログ・選択肢・メタ） ===== */
// キャラ別ボイス設定（v=声色, spd=文字送りms）
const SPK={
 hero:{v:'pico',spd:28}, lily:{v:'soft',spd:26}, mina:{v:'high',spd:36}, crow:{v:'noise',spd:30},
 arzen:{v:'heavy',spd:24}, boss:{v:'heavy',spd:26}, narr:{v:null,spd:20},
 kyle:{v:'pico',spd:26}, noa:{v:'soft',spd:30}, mel:{v:'high',spd:34}, sigma:{v:'noise',spd:30},
 leon:{v:'low',spd:24}, iris:{v:'high',spd:30}, gram:{v:'heavy',spd:22}, setc:{v:'low',spd:28}, riine:{v:'soft',spd:30},
};
function spkCfg(who){ return SPK[who]||SPK.narr; }
function dlgVoice(v){
  if(!v||G.muted||!audio()) return;
  const t=AC.currentTime;
  try{
    if(v==='noise'){ nzHit(t,{dur:0.03,f:900+Math.random()*2000,q:1.2,g:0.05}); return; }
    const M={pico:[640,'square',0.032],soft:[510,'triangle',0.038],high:[840,'sine',0.03],
             heavy:[150,'square',0.055],low:[230,'triangle',0.05]};
    const a=M[v]||M.pico, o=AC.createOscillator(), g=AC.createGain();
    o.type=a[1]; o.frequency.setValueAtTime(a[0]*(0.97+Math.random()*0.06),t);
    g.gain.setValueAtTime(0.0001,t); g.gain.exponentialRampToValueAtTime(0.06,t+0.004);
    g.gain.exponentialRampToValueAtTime(0.0001,t+a[2]);
    o.connect(g); g.connect(SFX_DEST||sfxBus); o.start(t); o.stop(t+a[2]+0.02);
  }catch(e){}
}
// 長文をページ分割（読みやすく1〜3行）
function splitPages(text){
  if(text.length<=64) return [text];
  let parts; try{ parts=text.split(/(?<=[。！？、])/); }catch(e){ parts=[text]; }
  // 句読点が無く長すぎる断片は強制的に分割
  const chunked=[]; parts.forEach(p=>{ while(p.length>72){ chunked.push(p.slice(0,72)); p=p.slice(72); } chunked.push(p); });
  const pages=[]; let cur='';
  for(const p of chunked){ if((cur+p).length>64 && cur){ pages.push(cur); cur=p; } else cur+=p; }
  if(cur) pages.push(cur); return pages.length?pages:[text];
}
// 会話ログ（記録帳）
function loadDlgLog(){ try{ return JSON.parse(localStorage.getItem(K('mg_log')))||[]; }catch(e){ return []; } }
function pushDlgLog(who,text,star){
  const log=loadDlgLog();
  let nm = who==='hero'?heroName() : who==='boss'?((curChapter()&&curChapter().bossNm)||'？？？') : ((PORT[who]||{}).nm||'');
  const place = G.storyMode&&curChapter()? curChapter().title : (DUNGEONS[G.dungeon]?DUNGEONS[G.dungeon].jp:'');
  log.push({who:nm, text, star:!!star, place});
  while(log.length>200) log.shift();
  try{ localStorage.setItem(K('mg_log'), JSON.stringify(log)); }catch(e){}
}
function flagSet(name){ G.flags=G.flags||{}; G.flags[name]=true;
  try{ localStorage.setItem(K('mg_flags'), JSON.stringify(G.flags)); }catch(e){} }
function hasFlag(name){ if(!G.flags){ try{ G.flags=JSON.parse(localStorage.getItem(K('mg_flags')))||{}; }catch(e){ G.flags={}; } } return !!G.flags[name]; }

// 登場人物の紹介文（初登場時に一度だけ自動表示）
const CHAR_DESC={
  hero:['','妹を救うため門を目指す、無口だが芯の強い少年。'],
  mia:['ミア','レンの妹。10歳。病に伏せっているが、心は明るい。'],
  mom:['母さん','レンとミアの母。'],
  doc:['医者','ミラージュ村の医者。'],
  elder:['村の長老','ミラージュゲートの言い伝えを知る老人。'],
  pico:['ピコ','門のなかでレンに話しかけてきた、しゃべるカードの精霊。軽口だが、たまに核心を突く。'],
  lily:['リリィ','明るくたくましいカード商人の少女。少しずる賢いが、根は優しい。'],
  noa:['ノア','まじめで臆病な、見習い門番の少年。'],
  garm:['ガルム','大きな剣を持つ、元王国騎士。過去に重い罪を背負う寡黙な大人。'],
  vail:['ヴェイル','門を開こうとする謎の男。失った娘を取り戻そうとしている。'],
  mob:['村人','その町に暮らす人。'],
  boss:['？？？','行く手をはばむ者。'],
  // 第2部
  kyle:['カイル','寡黙で一匹狼の探索者。'], mel:['メル','明るい召喚士の少女。'],
  sigma:['シグマ','操作型の頭脳派探索者。'], crow:['クロウ','闇市を仕切る情報屋。'],
  arzen:['アルゼン','探索者協会の試験官。'], leon:['レオン','探索者の青年。'],
  iris:['イリス','聡明な探索者の少女。'], gram:['グラム','大柄な傭兵。'],
};
function playCutscene(lines, onDone, bgKey){
  if(typeof titleBgmStop==='function') titleBgmStop();
  if(!lines||!lines.length){ if(onDone)onDone(); return; }
  // 各キャラの初登場時に「＊ 名前——説明」を自動で1度だけ挿入
  G.introduced=G.introduced||{};
  const aug=[];
  lines.forEach(l=>{ const who=Array.isArray(l)?l[0]:l.who;
    if(who && who!=='narr' && CHAR_DESC[who] && !G.introduced[who]){
      G.introduced[who]=true;
      const nm=who==='hero'?(G.playerName||'レン'):CHAR_DESC[who][0];
      aug.push(['narr','＊ '+nm+'——'+CHAR_DESC[who][1]]);
    }
    aug.push(l);
  });
  lines=aug;
  // 正規化: [who,text] / [who,text,expr] / [who,text,expr,opts]
  const entries=lines.map(l=> Array.isArray(l)
    ? {who:l[0], text:l[1], expr:l[2]||null, opts:l[3]||{}}
    : {who:l.speaker||l.who||'narr', text:l.text||'', expr:l.face||l.expr||null, opts:l});
  _cs={entries, i:0, onDone, pages:[], pi:0, typing:false, choosing:false, timer:null, sel:0};
  G._vnPartner=null;
  document.getElementById('csBg').style.backgroundImage =
    opBg(bgKey||vnBgKey(), 'linear-gradient(180deg,#1a1530,#0a0712)');
  document.getElementById('cutscene').classList.remove('hidden');
  showEntry(0);
}
function showEntry(i){
  const e=_cs.entries[i]; if(!e){ return; }
  const whoKey=e.who, expr=e.expr||autoExpr(whoKey,e.text);
  const cfg=spkCfg(whoKey), opts=e.opts||{};
  _cs.voice=opts.silent?null:cfg.v;
  _cs.speed=(opts.speed|0)|| (typeof dlgCharMs==='function'?dlgCharMs():cfg.spd); if(opts.effect==='slow') _cs.speed=Math.max(_cs.speed,70);
  _cs.silent=!!opts.silent || opts.effect==='silent';
  _cs.meta={ red:opts.effect==='red', tremor:opts.effect==='tremor', noflow:opts.effect==='noflow', shake:opts.effect==='shake' };
  _cs.classic = whoKey==='narr' || opts.classic || opts.mode==='classic';
  _cs.choices = opts.choices||null;
  // 名前
  let nm;
  if(whoKey==='hero') nm=heroName();
  else if(whoKey==='boss'){ const ch=curChapter(); nm=(ch&&ch.bossNm)||'？？？'; }
  else if(whoKey==='narr') nm='';
  else nm=(PORT[whoKey]||PORT.narr).nm;
  document.getElementById('csName').textContent=nm;
  document.getElementById('csName').style.display=nm?'':'none';
  // ログへ記録
  pushDlgLog(whoKey, e.text, opts.star);
  // 顔チップ＋立ち絵
  const box=document.getElementById('csBox');
  const faceWrap=document.getElementById('csFaceWrap');
  const heroSide=document.getElementById('csHeroSide'), partSide=document.getElementById('csPartnerSide');
  box.classList.toggle('classic', _cs.classic);
  if(_cs.classic){
    heroSide.classList.add('hide'); partSide.classList.add('hide');
    const cimg=(PORT[whoKey]||{}).img; // クラシック枠でも画像があれば顔チップを出す
    if(cimg){ faceWrap.classList.remove('hide');
      setSide(document.getElementById('csFace'), document.getElementById('csFaceEmo'),
        whoKey==='boss'?bossPortraitList():partnerPortrait(whoKey,expr), (PORT[whoKey]||{}).e||'🗨️'); }
    else faceWrap.classList.add('hide');
  } else {
    faceWrap.classList.remove('hide');
    // 立ち絵（主人公=左 / 相手=右）
    heroSide.classList.remove('hide');
    setSide(document.getElementById('csHero'), document.getElementById('csHeroEmo'), heroPortrait(whoKey==='hero'?expr:'neutral'), PORT.hero.e);
    const heroSpeaking=(whoKey==='hero');
    if(!heroSpeaking) G._vnPartner=whoKey;
    const pw=G._vnPartner;
    if(pw){ partSide.classList.remove('hide');
      const pe= whoKey===pw?expr:'neutral';
      const pemo=(PORT[pw]||{}).e||'👹';
      setSide(document.getElementById('csPartner'), document.getElementById('csPartnerEmo'),
        pw==='boss'?bossPortraitList():partnerPortrait(pw,pe), pemo);
    } else partSide.classList.add('hide');
    heroSide.classList.toggle('active',heroSpeaking); heroSide.classList.toggle('dim',!heroSpeaking&&!!pw);
    partSide.classList.toggle('active',!heroSpeaking); partSide.classList.toggle('dim',heroSpeaking);
    // 顔チップ＝話者
    const faceImg=document.getElementById('csFace'), faceEmo=document.getElementById('csFaceEmo');
    const cand = whoKey==='hero'?heroPortrait(expr) : (whoKey==='boss'?bossPortraitList():partnerPortrait(whoKey,expr));
    const emo = whoKey==='hero'?PORT.hero.e : ((PORT[whoKey]||{}).e||'👹');
    setSide(faceImg, faceEmo, cand, emo);
  }
  // メタ: ボックス揺れ
  if(_cs.meta.shake){ box.classList.remove('shake'); void box.offsetWidth; box.classList.add('shake'); }
  // ページ分割してタイプ開始
  _cs.pages=splitPages(e.text); _cs.pi=0;
  showPage();
}
function showPage(){
  const t=document.getElementById('csText');
  t.classList.toggle('tremor', !!_cs.meta.tremor);
  _cs.raw=(_cs.classic?'＊　':'')+_cs.pages[_cs.pi];
  startType();
}
function renderTyped(){
  const t=document.getElementById('csText');
  const s=_cs.raw.slice(0,_cs.shown);
  t.innerHTML = _cs.meta.red ? '<span class="rd">'+escapeHtml(s)+'</span>' : escapeHtml(s);
}
function escapeHtml(s){ return s.replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c])); }
function startType(){
  clearTimeout(_cs.timer); _cs.shown=0; _cs.typing=true;
  document.getElementById('csArrow').classList.remove('on');
  document.getElementById('csChoices').classList.add('hidden');
  renderTyped(); dlgTick();
}
function dlgTick(){
  if(!_cs){ return; }
  if(_cs.shown>=_cs.raw.length){ doneTyping(); return; }
  _cs.shown++; renderTyped();
  const ch=_cs.raw[_cs.shown-1];
  if(!_cs.silent && /\S/.test(ch) && _cs.shown%2===0) dlgVoice(_cs.voice);
  let d=_cs.speed;
  if(d>0){ if(/[、，]/.test(ch)) d+=170; if(/[。！？…]/.test(ch)) d+=240; }
  _cs.timer=setTimeout(dlgTick,d);
}
function doneTyping(){
  _cs.typing=false;
  if(_cs.choices){ renderChoices(); return; }
  if(!_cs.meta.noflow) document.getElementById('csArrow').classList.add('on');
}
function renderChoices(){
  _cs.choosing=true; _cs.sel=0;
  const box=document.getElementById('csChoices'); box.classList.remove('hidden');
  box.innerHTML='';
  _cs.choices.forEach((c,idx)=>{ const el=document.createElement('div');
    el.className='csChoice'+(idx===0?' sel':''); el.textContent=c.label;
    el.onclick=(ev)=>{ ev.stopPropagation(); chooseDlg(idx); };
    box.appendChild(el); });
  document.getElementById('csArrow').classList.remove('on');
}
function moveChoice(d){
  if(!_cs||!_cs.choosing) return;
  const n=_cs.choices.length; _cs.sel=(_cs.sel+d+n)%n;
  [...document.getElementById('csChoices').children].forEach((el,i)=>el.classList.toggle('sel',i===_cs.sel));
  sfxUISelect&&sfxUISelect();
}
function chooseDlg(idx){
  if(!_cs) return; const c=_cs.choices[idx]; sfxUIConfirm&&sfxUIConfirm();
  _cs.choosing=false; _cs.choices=null;
  document.getElementById('csChoices').classList.add('hidden');
  if(c.set) flagSet(c.set);
  if(c.cb){ const cb=c.cb; closeCutscene(); cb(); return; }
  nextEntry();
}
function nextEntry(){
  _cs.i++;
  if(_cs.i>=_cs.entries.length){ const cb=_cs.onDone; closeCutscene(); if(cb)cb(); return; }
  showEntry(_cs.i);
}
function closeCutscene(){
  if(_cs&&_cs.timer) clearTimeout(_cs.timer);
  document.getElementById('cutscene').classList.add('hidden');
  document.getElementById('csText').classList.remove('tremor');
  _cs=null;
}
function csAdvance(){ // 進行: タイプ中→全文 / ページ→次ページ / 文末→次の発言
  if(!_cs || _cs.choosing) return;
  if(_cs.typing){ clearTimeout(_cs.timer); _cs.shown=_cs.raw.length; renderTyped(); doneTyping(); return; }
  if(_cs.pi < _cs.pages.length-1){ _cs.pi++; showPage(); return; }
  nextEntry();
}
document.getElementById('cutscene').onclick=csAdvance;
// 会話ログUI
let _logOrderNew=true;
function openDlgLog(){
  const ov=document.getElementById('dlgLog'), list=document.getElementById('logList');
  let log=loadDlgLog().slice(); if(_logOrderNew) log.reverse();
  list.innerHTML = log.length? log.map(e=>
    `<div class="lg${e.star?' star':''}">${e.star?'<span class="st">★</span> ':''}<span class="who">${escapeHtml(e.who||'')}</span>${e.place?' <span style="color:#6f6b90;font-size:11px">（'+escapeHtml(e.place)+'）</span>':''}<br>${escapeHtml(e.text||'')}</div>`
  ).join('') : '<div class="empty">まだ会話の記録はありません。</div>';
  document.getElementById('logOrder').textContent=_logOrderNew?'新しい順 ⇅':'古い順 ⇅';
  ov.classList.remove('hidden');
}
function closeDlgLog(){ document.getElementById('dlgLog').classList.add('hidden'); }
document.getElementById('csLogBtn').onclick=(ev)=>{ ev.stopPropagation(); openDlgLog(); };
document.getElementById('logClose').onclick=closeDlgLog;
document.getElementById('logOrder').onclick=()=>{ _logOrderNew=!_logOrderNew; openDlgLog(); };

// ---- ストーリー進行 ----
function saveStory(){ try{
  let prev={}; try{ prev=JSON.parse(localStorage.getItem(K('mg_story')))||{}; }catch(e){}
  const o={ name:G.playerName||prev.name, job:G.job||prev.job, ver:STORY_VER,
    chapter:prev.chapter||0, cleared:prev.cleared||false,
    chapter2:prev.chapter2||0, cleared2:prev.cleared2||false,
    storyJob:G.storyJob||prev.storyJob||null, story2Job:G.story2Job||prev.story2Job||null,
    memShards:G.memShards||0, bossCards:G.bossCards||{}, titles:G.titles||{}, forbiddenEver:G.forbiddenEver||false };
  // 進行中の章は、そのキャンペーンの欄だけ更新（もう片方は保持）
  if(G.storyMode){
    if(G.campaign===2){ o.chapter2=G.storyChapter; o.cleared2=G.story2Cleared||prev.cleared2||false; o.cleared=G.storyCleared||prev.cleared||false; }
    else { o.chapter=G.storyChapter; o.cleared=G.storyCleared||prev.cleared||false; o.cleared2=G.story2Cleared||prev.cleared2||false; }
  } else { o.cleared=G.storyCleared||prev.cleared||false; o.cleared2=G.story2Cleared||prev.cleared2||false; }
  localStorage.setItem(K('mg_story'), JSON.stringify(o));
}catch(e){} }
function loadStory(){ try{ const s=JSON.parse(localStorage.getItem(K('mg_story')));
  if(s){ G.memShards=s.memShards||0; G.bossCards=s.bossCards||{}; G.titles=s.titles||{}; G.forbiddenEver=s.forbiddenEver||false;
    G.story2Cleared=s.cleared2||false; G.storyJob=s.storyJob||null; G.story2Job=s.story2Job||null; return s; } }catch(e){} return null; }
function part1Cleared(){ const s=loadStory(); return !!(s && s.cleared) || !!G.storyCleared; }
function updateStoryProg(){
  const s=loadStory();
  const el=document.getElementById('storyProg');
  if(s && s.name){ el.textContent=`つづきから: ${s.name} / ${STORY[Math.min(s.chapter,STORY.length-1)].title}${s.cleared?'（クリア済）':''}`; }
  else el.textContent='はじめての冒険';
  // 第2部ボタンの解放表示
  const b2=document.getElementById('story2Btn');
  if(b2){ const ok=part1Cleared();
    b2.classList.toggle('locked', !ok);
    const note=b2.querySelector('.s2note');
    if(note) note.textContent = ok ? (s&&s.cleared2?'第2部クリア済 — 探索者試験編':'探索者試験編 — 挑戦できる！')
                                   : '🔒 第1部をクリアすると解放';
  }
  refreshSlotBtn();
}
function startStory(){
  const prev=loadStory();
  // 名前は最初の一回だけ入力。以後はセーブされた名前でずっと続く。
  let name;
  if(prev && prev.name && (prev.ver|0)===STORY_VER){ name=prev.name; }
  else { name=prompt('主人公（レン）の名前を入力してください', (prev&&prev.name)||'レン'); if(name===null) return; }
  name=(name||'レン').slice(0,8);
  G.playerName=name; G.storyMode=true; G.campaign=1;
  // 同名かつ同シナリオ版のセーブのみ続きから。旧シナリオのセーブは序章からやり直し。
  if(prev && prev.name===name && (prev.ver|0)===STORY_VER){ G.storyChapter=prev.chapter||0; G.storyCleared=prev.cleared; }
  else { G.storyChapter=0; G.storyCleared=false; }
  // 第1部は職業選択なし：主人公レン固定（戦士と魔法使いの中間／MP=HP半分）
  G.job='ren'; G.storyJob='ren';
  saveStory();
  // 序章「妹の眠る部屋」——最初は、レンと妹ミアの二人だけの場面。
  const intro=[
    ['narr','＊ 小さな町、ミラージュ村。丘の上の小さな家に、兄と妹がふたりで暮らしていた。'],
    ['narr','＊ 妹のミアは、長いあいだ、ベッドから起きあがれずにいる。'],
    ['mia','おにいちゃん。今日はね、すこしだけ、調子がいいみたい。','smile',{star:true}],
    ['hero','……そうか。じゃあ、窓を開けよう。','',null],
    ['mia','うん。風が入ると、外の世界とつながってる気がするの。','smile'],
    ['hero','また、いっしょに丘の上まで歩こうな。元気になったら。','',null],
    ['mia','……ねえ、レン。もし、わたしがいなくなっても。','sad'],
    ['mia','ちゃんとごはん食べて、笑っててね。','sad',{star:true}],
    ['hero','そんなこと、言うな。……俺が、なんとかする。きっとだ。','determined',{star:true}],
    ['narr','＊ その夜、谷のむこうで——封印されたはずの「ミラージュゲート」が、ふたたび光りはじめた。'],
    ['narr','＊ どんな願いも叶えるという、伝説の門。'],
    ['hero','ミアを助ける方法が、あの門にあるなら……行く。','determined'],
    ['hero','何があっても、連れて帰る。','determined'],
    ['narr','＊ レンは、たったひとり、門へと歩きだした。'],
  ];
  if(G.storyChapter===0){
    // 序章 → レンのプロローグ → 第1章（職業選択なし）
    playCutscene(intro, ()=> playCutscene(JOB_LORE.ren.prologue, ()=>enterChapter(0), 'bg_home'), 'bg_home');
  } else enterChapter(G.storyChapter);
}
// 第2部：探索者試験編（第1部クリア後に解放）
function startStory2(){
  if(!part1Cleared()){ log("第2部は第1部クリア後に解放されます","l-warn"); return; }
  const prev=loadStory();
  // 名前は第1部と同じ（最初に設定した名前を継続）。第2部もレン固定で職業選択なし。
  let name = (prev && prev.name) ? prev.name : prompt('主人公（レン）の名前を入力してください','レン');
  if(name===null) return; name=(name||'レン').slice(0,8);
  G.playerName=name; G.storyMode=true; G.campaign=2;
  G.job='ren'; G.story2Job='ren';
  G.storyChapter = (prev && prev.chapter2) || 0;
  G.story2Cleared = !!(prev && prev.cleared2);
  saveStory();
  const intro=[
    ['narr','ミラージュゲートの封印は、再び破られた。'],
    ['narr','門の周りには、世界中から冒険者・研究者・傭兵・商人が集まっている。'],
    ['narr','だが正式に門へ入れるのは——探索者協会が認めた、資格者だけ。'],
    ['narr','記憶を失くした少年が、街で違法カード売買に巻き込まれていた。'],
    ['narr','唯一の手がかりは、古いカードホルダーと、「ミア」と刻まれた壊れたカード。'],
    ['lily','……ねえ、君。探索者に、なってみる気はない？','smile'],
  ];
  if(G.storyChapter===0){
    playCutscene(intro, ()=>enterChapter(0));
  } else enterChapter(G.storyChapter);
}
function enterChapter(i){
  G.storyChapter=i; saveStory();
  const ch=curStory()[i];
  const locked=curJobLock(); if(locked) G.job=locked; // 物語では職業固定
  const begin=()=> playCutscene(ch.intro, ()=>{
    // 章のダンジョンは固定。職業は最初に固定済み → デッキのみ。
    G.storyMode=true; G.dungeon=ch.dungeon; G.storyBossShown=false; G._memShown={};
    if(ch.dungeon==='maboroshi') G.maboroshiAvail=true;
    document.body.classList.remove('setupbg');
    document.getElementById('setup').classList.remove('hidden');
    document.getElementById('storyDunNote').classList.remove('hidden');
    document.getElementById('storyDunNote').textContent=`📖 ${ch.title} — ${DUNGEONS[ch.dungeon].jp} ／ ${JOBS[G.job].emoji}${JOBS[G.job].jp}`;
    document.querySelector('.step[data-s="0"]').classList.add('hidden'); // 職業段は出さない（固定）
    document.querySelector('.step[data-s="1"]').classList.add('hidden'); // ダンジョン段も出さない
    const b2=document.getElementById('back2'); if(b2) b2.style.display='none';
    document.getElementById('modePick').classList.add('hidden');
    document.getElementById('freeSetup').classList.remove('hidden');
    showStep(2); // デッキ編成のみ
  });
  showChapterScene(ch, begin); // 章のシーン画像カード → イントロ会話
}
// 章開始時のシーン画像カード（scene が無ければ素通り）
function showChapterScene(ch, done){
  const ov=document.getElementById('chapCard');
  if(!ov || !ch || !ch.scene){ done&&done(); return; }
  ov.querySelector('.bg').style.backgroundImage = opBg(ch.scene,'linear-gradient(180deg,#15101f,#0a0712)');
  ov.querySelector('.ct').textContent=ch.title;
  ov.querySelector('.cs').textContent=DUNGEONS[ch.dungeon]?DUNGEONS[ch.dungeon].jp:'';
  ov.classList.remove('hidden'); requestAnimationFrame(()=>ov.classList.add('show'));
  let ended=false;
  const fin=()=>{ if(ended)return; ended=true; ov.classList.remove('show');
    setTimeout(()=>{ ov.classList.add('hidden'); done&&done(); }, 600); };
  const t=setTimeout(fin, 3200);
  ov.onclick=()=>{ clearTimeout(t); fin(); };
}
// 終章の最深部に到達した時の3択エンディング
function endingChoice(){
  bgmStop();
  const c2=G.campaign===2;
  const m=document.getElementById('choiceModal');
  document.getElementById('choice').classList.remove('hidden');
  const sub = c2 ? '幻影のオーブの前。レオンと並び、あなたは何を選ぶ——'
                 : '幻影のオーブの前。ヴェイルと並び、レンは何を選ぶ——';
  const labs = c2
    ? ['1. オーブを解放する（カード化された者を戻す）','2. オーブを壊す（世界を救う）','3. カードホルダーを置く（…切らない）']
    : ['1. 奇跡のカードを使う（妹を救う）','2. 奇跡のカードを破壊する（門を閉じる）','3. 門の仕組みを書き換える（分け合う）'];
  m.innerHTML=`<div class="big center gold">最後の選択</div>
    <p class="center muted" style="font-size:13px">${sub}</p>
    <div class="col" style="gap:8px;margin-top:12px">
      <button id="endBad">${labs[0]}</button>
      <button id="endNormal">${labs[1]}</button>
      <button class="primary" id="endTrue">${labs[2]}</button>
    </div>`;
  document.getElementById('endBad').onclick=()=>ending('bad');
  document.getElementById('endNormal').onclick=()=>ending('normal');
  document.getElementById('endTrue').onclick=()=>{
    // TRUE END条件: 物語を通して禁忌カードを一度も使っていないこと
    if(G.forbiddenEver || (G.forbiddenUsed||0)>0){ ending('tainted'); }
    else ending('true');
  };
}
function ending(kind){
  document.getElementById('choice').classList.add('hidden');
  let lines;
  if(G.campaign===2){ lines=ending2Lines(kind); playEnding(kind, lines); return; }
  if(kind==='tainted') lines=[   // 禁忌カードを使っていた場合
    ['narr','＊ 門を書き換えるには——“奪わずに来た手”が要った。'],
    ['pico','レン。きみの手は、もう少しだけ、願いに濡れている。','sad'],
    ['mia','それでも、止まろうとしてくれた。それだけで、十分だよ。','sad'],
    ['narr','＊ 門は閉じた。だが、本当に“書き換える”には、あと一歩、綺麗な手が要った。'],
    ['narr','＊ — もうひとつのエンド：濁った手 —'],
    ['narr','＊ （禁忌カードを使わずに最後の選択へ至ると、真エンドに届く）']];
  else if(kind==='bad') lines=[   // 奇跡のカードを使う：やさしい代償
    ['narr','＊ レンは、奇跡のカードを使った。'],
    ['mia','お兄ちゃん、ありがとう。私……生きてるんだね。','smile',{star:true}],
    ['pico','うん。……誰かの、明日の上にね。','sad',{star:true}],
    ['narr','＊ ミアは助かり、ヴェイルの娘も戻った。だが——どこか遠くで、子どもたちの未来が消えた。'],
    ['narr','＊ 願いは叶った。一見、幸せな朝。けれどその陰で、誰かが泣いている。'],
    ['narr','＊ — エンド：やさしい代償 —']];
  else if(kind==='normal') lines=[ // 奇跡のカードを破壊：閉じた門
    ['narr','＊ レンは、奇跡のカードを砕いた。門が、静かに閉じていく。'],
    ['mia','お兄ちゃん。私のために、世界を壊さなかったんだね。','sad',{star:true}],
    ['hero','',null,{choices:[
      {label:'ごめん', set:'end_normal'},{label:'ありがとう', set:'end_normal'},{label:'ずっと覚えてる', set:'end_normal'}]}],
    ['mia','それなら、私は消えないよ。お兄ちゃんが、覚えてるなら。','smile',{star:true}],
    ['narr','＊ 世界は救われた。カードの奇跡は消え、ミアは還らなかった。'],
    ['narr','＊ — エンド：閉じた門 —']];
  else lines=[                     // 門を書き換える：真エンド
    ['narr','＊ レンは、奪う奇跡を——分け合う力へと、書き換えた。'],
    ['vail','戻らないのか……私の、娘は。','sad'],
    ['pico','戻らないものは、あるよ。でも——届くものも、あるんだ。','sad',{star:true}],
    ['mia','お父さん。世界を、許してあげて。私が好きだった世界だから。','smile',{star:true}],
    ['vail','私は……私は、何のために、ここまで。','sad'],
    ['garm','愛した者を、忘れないためだ。——壊すためでは、ない。','',{star:true}],
    ['mia','お兄ちゃん。私、すぐには治らないんだね。','sad'],
    ['noa','でも、未来は戻った。それは——明日を、待てるってことだ。','determined',{star:true}],
    ['lily','奇跡ってさ。願いが一瞬で叶うことじゃなくて、まだ続きがあるって思えることなのかもね。','smile',{star:true}],
    ['pico','ぼくはカードです。でも、もう、使われるだけのカードじゃありません。','smile'],
    ['pico','これからは、しおりになります。みんなの“続き”を、忘れないための。','smile',{star:true}],
    ['narr','＊ — 真エンド：封印カードの迷宮 —']];
  playEnding(kind, lines);
}
// 第2部のエンディング台詞
function ending2Lines(kind){
  if(kind==='tainted') return [
    ['hero','俺は、カードホルダーを置こうとした。'],
    ['hero','けれど、この手はもう禁忌に触れすぎていた。'],
    ['leon','濡れた手では、何も置けないよ。'],
    ['mina','それでも、止まろうとしてくれた。……ありがとう、お兄ちゃん。'],
    ['narr','門は閉じた。だが、本当に「置く」には、もう少し綺麗な手が要った。'],
    ['narr','— もうひとつのエンド：濁った手 —'],
    ['narr','（禁忌カードを使わずに最後の選択を迎えると、TRUE END に至る）']];
  if(kind==='bad') return [ // 解放
    ['hero','……オーブを、解放する。'],['leon','賢明だ。さあ、皆が還ってくる。'],
    ['mina','お兄ちゃん……どうして？'],
    ['narr','カード化された者たちが還った。だが同時に、世界中に迷宮が口を開いた。'],
    ['mina','私は、こんな世界で生きたかったわけじゃないよ。'],
    ['narr','— BAD END：解放 —']];
  if(kind==='normal') return [ // 破壊
    ['hero','……オーブを、壊す。'],['leon','やめろ……皆が、消える……！'],
    ['narr','門は砕けた。魔物も、カードも、迷宮も、世界から消えた。'],
    ['mina','ありがとう、お兄ちゃん。これで、もう誰も願いに飲まれない。'],
    ['mina','ばいばい。私のことは、忘れていいよ。'],
    ['hero','……忘れない。'],
    ['narr','英雄は、空っぽの手で帰っていった。'],
    ['narr','— NORMAL END：破壊 —']];
  return [ // 封印（true）
    ['hero','俺は、カードホルダーを置く。'],
    ['hero','失った者を取り戻すために、誰かを犠牲にするのは違う。'],
    ['leon','……ああ。俺も、置くよ。'],
    ['narr','レオンは、奪い集めたカードを、静かに門へ返した。'],
    ['mina','ミアは戻らない。でも——'],
    ['mina','門の中の魂たちは、ようやく眠れる。それで、十分だよ。'],
    ['narr','ミラージュゲートは、完全には壊されなかった。'],
    ['narr','管理された試練として、門は残った。'],
    ['narr','探索者協会も変わった。カードを「資源」ではなく、「封印された命」として扱うようになった。'],
    ['narr','— TRUE END：カードを置く者 —']];
}
// エンディング共通の再生＋クリア処理（第1部/第2部）
function playEnding(kind, lines){
  const c2=G.campaign===2;
  playCutscene(lines, ()=>{
    G.storyCleared=true;
    if(c2) G.story2Cleared=true;
    if(kind==='true'){ G.endlessAvail=true; saveGame();
      earnTitle(c2?'clear2True':'clearTrue');
      if(!G.forbiddenEver) earnTitle('noForbidden'); }
    if(kind==='normal') earnTitle(c2?'clear2Normal':'clearNormal');
    saveStory();
    const lbl = c2
      ? {true:'TRUE END',tainted:'濁った手 END',normal:'NORMAL END',bad:'BAD END'}[kind]
      : {true:'真エンド「封印カードの迷宮」',tainted:'もうひとつのエンド「濁った手」',normal:'エンド「閉じた門」',bad:'エンド「やさしい代償」'}[kind];
    const extra = kind==='true' ? '<p class="center gold">✨ クリア後モード「大いなる幻影迷宮」が解放された！（フリープレイの幻が常時出現）</p>'
      : (kind==='tainted' ? '<p class="center muted" style="font-size:12px">禁忌カードを使わずに最後の選択へ至ると、真エンドに到達できます。</p>' : '');
    const ttl = c2 ? '第2部をクリアした' : '物語をクリアした';
    showModal(`<div class="big center gold">${ttl}</div>
      <p class="center">${lbl} を見ました。</p>${extra}
      <div class="center" style="margin-top:14px"><button class="primary" id="stEnd">タイトルへ</button></div>`);
    document.getElementById('stEnd').onclick=()=>{ hideModal(); returnToTitle(); };
  });
}
function returnToTitle(){
  G.storyMode=false; G.over=true; G.campaign=1;
  document.body.classList.add('setupbg');
  document.getElementById('game').classList.add('hidden');
  document.getElementById('setup').classList.remove('hidden');
  document.getElementById('freeSetup').classList.add('hidden');
  document.getElementById('modePick').classList.remove('hidden');
  document.getElementById('storyDunNote').classList.add('hidden');
  document.querySelector('.step[data-s="0"]').classList.remove('hidden'); // 次回用に職業段を復帰
  document.querySelector('.step[data-s="1"]').classList.remove('hidden');
  const b0=document.getElementById('back0'); if(b0) b0.style.display='';
  const b2=document.getElementById('back2'); if(b2) b2.style.display='';
  G._jobSelCb=null; G.bag=[]; G._cap=null; G.worldMode=false; bgmStop(); updateStoryProg(); renderSetup();
  document.getElementById('worldWrap').classList.remove('show');
  if(typeof titleBgmStart==='function') titleBgmStart();
}
/* 常設「タイトルへ」ボタン: ダンジョン進行中は確認してからタイトル画面へ */
function goHomeFromButton(){
  const gameVisible=!document.getElementById('game').classList.contains('hidden');
  const inRun = gameVisible && G.map && !G.over;
  const doIt=()=>{
    try{ titleBgmStop&&titleBgmStop(); }catch(e){}
    try{ bgmStop&&bgmStop(); }catch(e){}
    G.over=true; G.aimMode=null;
    ['game','setup','worldWrap'].forEach(id=>{ const el=document.getElementById(id); if(el){ el.classList.add('hidden'); el.classList.remove('show'); } });
    document.body.classList.remove('setupbg');
    if(typeof showTitleMenu==='function') showTitleMenu();
  };
  if(inRun){
    showModal(`<h2>タイトルに戻りますか？</h2>
      <p class="muted" style="font-size:13px">いまの冒険の進行は失われます（セーブ済みデータは残ります）。</p>
      <div class="grid2" style="margin-top:12px"><button class="danger" id="ghY">タイトルへ戻る</button><button id="ghN">つづける</button></div>`);
    document.getElementById('ghN').onclick=hideModal;
    document.getElementById('ghY').onclick=()=>{ hideModal(); doIt(); };
  } else doIt();
}
function wireHomeBtn(){
  const hb=document.getElementById('homeBtn'); if(!hb) return;
  hb.addEventListener('click', goHomeFromButton);
  // 会話/ムービー/タイトル/モーダル表示中は隠す（重なり防止）
  const upd=()=>{
    const hide = !document.getElementById('opening').classList.contains('hidden')
      || !document.getElementById('cutscene').classList.contains('hidden')
      || !document.getElementById('titleMenu').classList.contains('hidden')
      || !document.getElementById('overlay').classList.contains('hidden');
    hb.classList.toggle('hidden', hide);
  };
  setInterval(upd, 300); upd();
}
if(document.readyState!=='loading') wireHomeBtn(); else document.addEventListener('DOMContentLoaded', wireHomeBtn);
// ---- カード図鑑（ボスカード＋収集状況） ----
function showDex(){
  loadStory();
  const rows=Object.entries(BOSS_CARDS).map(([k,b])=>{
    const got=G.bossCards&&G.bossCards[k];
    return `<div style="display:flex;gap:10px;align-items:flex-start;padding:8px;border-bottom:1px solid var(--line);${got?'':'opacity:.4'}">
      <div style="font-size:30px">${got?b.ic:'❔'}</div>
      <div><b class="${got?'gold':'muted'}">${got?b.nm:'？？？（未入手）'}</b>
        <div class="muted" style="font-size:11px;line-height:1.5">${got?b.lore:'まだ封印していないボスカード。'}</div></div></div>`;
  }).join('');
  const owned=Object.values(G.collection||{}).reduce((a,b)=>a+b,0);
  showModal(`<h2>📚 カード図鑑</h2>
    <p class="muted" style="font-size:12px">所持カード総数: <b class="gold">${owned}</b> 枚 / ボスカード ${Object.values(G.bossCards||{}).filter(Boolean).length}/${Object.keys(BOSS_CARDS).length}</p>
    <div class="scroll" style="max-height:340px">${rows}</div>
    <div class="center" style="margin-top:10px"><button id="dexClose">閉じる</button></div>`);
  document.getElementById('dexClose').onclick=hideModal;
}
// ---- コレクション一覧（横スクロール / 回復→攻撃→特殊→レア→モンスター） ----
const GAL_SECS=[
  {key:'heal', nm:'回復系',       ic:'🧪', col:'#4fae74'},
  {key:'atk',  nm:'攻撃系',       ic:'🔥', col:'#c45040'},
  {key:'spec', nm:'特殊系',       ic:'✨', col:'#4d8cc8'},
  {key:'rare', nm:'レア系（禁忌）',ic:'🔮', col:'#c08cff'},
  {key:'mon',  nm:'モンスター系',  ic:'🐉', col:'#e6c45a'},
];
function galSectionIds(key){
  const ids=Object.keys(CARDS);
  if(key==='heal') return ids.filter(id=>CARDS[id].cat==='heal' && !CARDS[id].forbidden);
  if(key==='atk')  return ids.filter(id=>CARDS[id].cat==='atk'  && !CARDS[id].forbidden);
  if(key==='spec') return ids.filter(id=>['sup','buff','equip'].includes(CARDS[id].cat) && !CARDS[id].forbidden);
  if(key==='rare') return ids.filter(id=>CARDS[id].forbidden);
  return [];
}
function galCardHTML(id, isMon){
  let nm,ic,ds,r,art,cat,owned,cnt;
  if(isMon){ const b=BOSS_CARDS[id]; cnt=(G.bossCards&&G.bossCards[id])?1:0; owned=cnt>0;
    nm=b.nm; ic=b.ic; ds=b.lore; r=bossRarity(id); art=null; cat='buff'; }
  else { const c=CARDS[id]; cnt=(G.collection[id]||0); owned=cnt>0;
    nm=c.nm; ic=c.ic; ds=c.ds; r=cardRarity(id); art=cardArtPath(id); cat=c.cat; }
  const artHtml = owned ? (art?`<img src="${art}">`:`<span class="emoji">${ic}</span>`) : `<span class="emoji" style="opacity:.7">❔</span>`;
  return `<div class="card cat-${cat} holo rar-${r} ${owned?'':'gunowned'}" title="${owned?nm+'〔'+r+'〕':'未入手'}" style="width:132px">
    ${cnt>1?`<div class="ccount">×${cnt}</div>`:''}
    <div class="cname"><span class="crar r-${r}">${r}</span><span class="cnm">${owned?nm:'？？？'}</span></div>
    <div class="cart">${artHtml}</div>
    <div class="ctype">${isMon?'モンスター — ボスカード':(CAT_JP[cat]||cat)}</div>
    <div class="ctext">${owned?ds:'未入手 — 集めて図鑑を埋めよう'}</div>
  </div>`;
}
function showGallery(){
  loadStory();
  let totalOwn=0, totalAll=0;
  const secsHTML=GAL_SECS.map(s=>{
    let ids, isMon=(s.key==='mon');
    if(isMon){ ids=Object.keys(BOSS_CARDS); }
    else { ids=galSectionIds(s.key).sort((a,b)=>RAR_ORDER[cardRarity(a)]-RAR_ORDER[cardRarity(b)] || (CARDS[a].cost-CARDS[b].cost)); }
    const own = isMon ? ids.filter(id=>G.bossCards&&G.bossCards[id]).length
                      : ids.filter(id=>(G.collection[id]||0)>0).length;
    totalOwn+=own; totalAll+=ids.length;
    const cards=ids.map(id=>galCardHTML(id,isMon)).join('');
    return `<div class="galsec" style="--sc:${s.col}">
      <h4 style="--sc:${s.col}">${s.ic} ${s.nm} <span class="muted" style="font-weight:400">${own}/${ids.length}</span></h4>
      <div class="galgrid">${cards}</div></div>`;
  }).join('');
  const pct=totalAll?Math.round(totalOwn/totalAll*100):0;
  showModal(`<h2 style="margin-bottom:2px">🗂️ コレクション一覧</h2>
    <p class="muted" style="font-size:12px;margin:2px 0 8px">達成度 <b class="gold">${totalOwn}/${totalAll}</b>（${pct}%）　←→ 横スクロールで 回復→攻撃→特殊→レア→モンスター</p>
    <div class="galrow">${secsHTML}</div>
    <div class="center" style="margin-top:8px"><button id="galClose">閉じる</button></div>`);
  document.getElementById('modal').classList.add('wide');
  document.getElementById('galClose').onclick=hideModal;
}
// ---- 称号 ----
function showTitles(){
  loadStory();
  const rows=TITLES.map(t=>{ const got=G.titles&&G.titles[t.id];
    return `<div style="padding:7px;border-bottom:1px solid var(--line);${got?'':'opacity:.4'}">
      <b class="${got?'gold':'muted'}">${got?t.nm:'🔒 ？？？'}</b>
      <div class="muted" style="font-size:11px">${t.desc}</div></div>`;}).join('');
  showModal(`<h2>🏆 称号</h2><div class="scroll" style="max-height:320px">${rows}</div>
    <div class="center" style="margin-top:10px"><button id="ttClose">閉じる</button></div>`);
  document.getElementById('ttClose').onclick=hideModal;
}
// ---- クロウの闇市（記憶片で禁忌カードを購入） ----
function showBazaar(){
  loadStory();
  const items=['bloodfire','soulreturn','memeater','orbcall'];
  const cards=items.map(id=>{ const c=CARDS[id];
    return `<div class="card cat-atk" data-id="${id}" style="width:124px">
      <div class="cart emoji"><span class="emoji">${c.ic}</span></div>
      <div class="cname"><span>${c.nm}</span></div>
      <div class="ctext">${c.ds}</div>
      <div class="cfoot"><span>🔹${c.shard}</span><span class="danger">禁忌</span></div></div>`;}).join('');
  showModal(`<h2>🦅 クロウの闇市</h2>
    <p class="muted" style="font-size:12px">記憶片 <b class="gold">🔹${G.memShards||0}</b>。
    禁忌カードは強力だが、使うと最大HP低下などの代償があり、<b class="danger">使うと TRUE END が遠のく</b>。</p>
    <div class="cards" id="bzWrap" style="justify-content:center">${cards}</div>
    <div class="center" style="margin-top:10px"><button id="bzClose">閉じる</button></div>`);
  document.querySelectorAll('#bzWrap .card').forEach(el=>{
    el.onclick=()=>{ const id=el.dataset.id, c=CARDS[id];
      if((G.memShards||0)<c.shard){ log("記憶片が足りない","l-warn"); sfxCard&&sfxCard('fail'); return; }
      G.memShards-=c.shard; G.collection[id]=(G.collection[id]||0)+1; saveGame(); saveStory();
      log(`🩸 ${c.nm} を手に入れた（コレクションに追加）`,"l-warn"); showBazaar(); };
  });
  document.getElementById('bzClose').onclick=hideModal;
}
/* ===== ステップ式セットアップの制御 ===== */
function showStep(n){
  G.setupStep=n;
  for(let k=0;k<3;k++) document.getElementById('step'+k).classList.toggle('hidden', k!==n);
  document.querySelectorAll('.steps .step').forEach(el=>{
    const s=+el.dataset.s;
    el.classList.toggle('active', s===n);
    el.classList.toggle('done', s<n);
    // ストーリーではダンジョン段は「固定」表示
    if(G.storyMode && s===1){ el.style.opacity='.5'; }
    else el.style.opacity='';
  });
  // 各段に入る時に内容を最新化
  renderSetup();
}
function openSetup(){
  document.getElementById('modePick').classList.add('hidden');
  document.getElementById('freeSetup').classList.remove('hidden');
  showStep(0);
}
// ボタン配線
document.getElementById('storyBtn').onclick=()=>{ sfxUIConfirm&&sfxUIConfirm(); startStory(); };
document.getElementById('story2Btn').onclick=()=>{
  if(!part1Cleared()){ sfxUIBack&&sfxUIBack();
    showModal(`<h2>🔒 第2部はまだ解放されていません</h2>
     <p class="muted" style="font-size:13px">第2部「探索者試験編」は、第1部のストーリーをクリアすると挑戦できます。<br>
     まずは📖ストーリーモードを最後まで進めましょう。</p>
     <div class="center" style="margin-top:12px"><button class="primary" id="s2Close">わかった</button></div>`);
    document.getElementById('s2Close').onclick=hideModal; return; }
  sfxUIConfirm&&sfxUIConfirm(); startStory2();
};
document.getElementById('freeBtn').onclick=()=>{
  sfxUIConfirm&&sfxUIConfirm();
  G.storyMode=false; G.campaign=1; G._jobSelCb=null;
  document.getElementById('storyDunNote').classList.add('hidden');
  // 物語で隠していた段・ボタンをフリープレイ用に復帰
  document.querySelector('.step[data-s="0"]').classList.remove('hidden');
  document.querySelector('.step[data-s="1"]').classList.remove('hidden');
  const b0=document.getElementById('back0'); if(b0) b0.style.display='';
  const b2=document.getElementById('back2'); if(b2) b2.style.display='';
  openSetup();
};
// 職業 → ダンジョン → デッキ（ストーリーはダンジョン段をスキップ）
