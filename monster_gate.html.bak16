  "ホッピー":mpose('hoppy'),"キラーホッピー":mpose('hoppy'),"リザード":mpose('lizard'),
  "ケムンパ":mpose('caterpillar'),"キラービー":mpose('bee'),"キラービー群":mpose('bee'),
  "マザービー":mpose('queenbee'),"スピット":mpose('spit'),"魔道士":mpose('mage'),
  "プリースト":mpose('priest'),"ビショップ":mpose('priest'),"リスタール":mpose('golem'),
  "バルチャー":mpose('vulture'),"グランシャーク":mpose('shark'),"ターミネーター":mpose('robot'),
  "死神":mpose('reaper'),"マッドブル":mpose('madbull'),"ベノム":mpose('venom'),
  "エビルアイ":mpose('evileye'),"リスタドラゴン":mpose('darkdragon'),
  "キングドラゴン":mpose('kingdragon'),"デーモン":mpose('demon'),"カオス":mpose('chaos'),
};
function poseSprite(name,e){
  const p=MON_POSE[name]; if(!p) return null;
  const st = e._lunge ? 'attack' : e._hit ? 'hit' : null;
  if(!st) return null;
  const im=getImg(p[st]);
  return (im&&im._ok) ? p[st] : null;
}
