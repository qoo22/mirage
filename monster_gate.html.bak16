// 究極の門を30Fの長丁場に（最大難易度）。30フロア分の出現帯を難易度順から自動生成。
(function deepenUltimate(){
  const order=["ゴブリン","スピット","魔道士","プリースト","バルチャー","キラービー群","ベノム",
    "グランシャーク","リスタール","ターミネーター","ドラゴン","死神","ビショップ","マッドブル",
    "エビルアイ","デーモン","リスタドラゴン","キングドラゴン","カオス"];
  const bands=[];
  for(let f=0; f<30; f++){
    // 進行に応じて窓を後ろへスライド（序盤は弱め、終盤はカオス級）
    const center=Math.floor((order.length-3) * (f/29));
    const lo=Math.max(0, Math.min(order.length-4, center));
    bands.push([order[lo],order[lo+1],order[lo+2],order[lo+3]].filter(Boolean));
  }
  DUNGEONS.ultimate.floors=30;
  DUNGEONS.ultimate.win=2400;
  DUNGEONS.ultimate.bet=60;
  DUNGEONS.ultimate.star=9;
  DUNGEONS.ultimate.size=17;
  DUNGEONS.ultimate.desc="30Fの長丁場・最大難易度。総合力と持ち込み設計が試される最終試練。";
  DUNGEONS.ultimate.bands=bands;
})();

