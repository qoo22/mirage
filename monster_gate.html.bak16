const _imgCache = {};
function getImg(path){
  if(!path) return null;
  if(_imgCache[path] !== undefined) return _imgCache[path];
  const im = new Image(); im.src = path; _imgCache[path]=im;
  im.onload=()=>{ im._ok=true; }; im.onerror=()=>{ im._ok=false; };
  return im;
}

