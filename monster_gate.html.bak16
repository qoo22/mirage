<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>ミラージュゲート — MIRAGE GATE</title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DotGothic16&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0d0b14; --panel:#171327; --panel2:#1f1936; --ink:#e9e4ff; --muted:#9b91c4;
    --gold:#ffcf4d; --hp:#ff5b6e; --mp:#5bb8ff; --good:#5bf0a0; --bad:#ff7a59;
    --line:#2c2547; --accent:#b079ff;
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%;background:var(--bg);color:var(--ink);
    font-family:"Hiragino Kaku Gothic ProN","Yu Gothic",system-ui,sans-serif;}
  /* 選択画面の荘厳な背景 */
  body{ background:
      radial-gradient(1200px 700px at 50% -8%, rgba(123,77,255,.14), transparent 60%),
      linear-gradient(180deg,#0c0a18,#0a0814 60%,#08060f);
    background-attachment:fixed; }
  body.setupbg::before{ content:""; position:fixed; inset:0; z-index:-1;
    background:url("assets/ui_bg.png") center/cover no-repeat;
    opacity:.20; filter:saturate(.85); }
  body.setupbg::after{ content:""; position:fixed; inset:0; z-index:-1;
    background:radial-gradient(900px 600px at 50% 30%, transparent, rgba(8,6,15,.86) 78%);
    pointer-events:none; }
  /* チュートリアルのヒントトースト */
  #tutToast{ position:absolute; left:50%; top:14px; transform:translate(-50%,-12px);
    max-width:86%; padding:11px 18px; border-radius:12px; pointer-events:none;
    background:linear-gradient(180deg,rgba(38,30,72,.96),rgba(22,17,44,.96));
    border:1px solid #b79bff; box-shadow:0 6px 22px rgba(0,0,0,.5),0 0 18px rgba(150,110,255,.35);
    color:#f3eeff; font-size:14px; font-weight:700; line-height:1.5; text-align:center;
    letter-spacing:.02em; opacity:0; transition:opacity .35s, transform .35s; z-index:30; }
  #tutToast.show{ opacity:1; transform:translate(-50%,0); }
  #tutToast .k{ display:inline-block; padding:1px 7px; margin:0 2px; border-radius:6px;
    background:#3a2f6b; border:1px solid #6f5fb0; font-size:12px; color:#ffe9a8; }
  /* ===== オープニング・シネマティック ===== */
  #opening{ position:fixed; inset:0; z-index:200; background:#000; overflow:hidden;
    cursor:pointer; opacity:1; transition:opacity .8s; }
  #opening.fadeout{ opacity:0; }
  .opImg{ position:absolute; inset:0; background-position:center; background-size:cover;
    opacity:0; transition:opacity 1.3s ease; transform:scale(1.06); }
  .opImg.show{ opacity:1; }
  .opImg.kb{ animation:opKenBurns 9s ease-out forwards; }
  @keyframes opKenBurns{ from{transform:scale(1.02) translate(0,0)} to{transform:scale(1.15) translate(-1.5%,-2%)} }
  #opVig{ position:absolute; inset:0; pointer-events:none;
    background:radial-gradient(120% 90% at 50% 42%, transparent 38%, rgba(2,1,6,.72) 100%); }
  /* シネマの上下黒帯 */
  #opening::before,#opening::after{ content:""; position:absolute; left:0; right:0; height:9vh;
    background:#000; z-index:5; pointer-events:none; }
  #opening::before{ top:0; } #opening::after{ bottom:0; }
  #opCap{ position:absolute; left:0; right:0; bottom:15vh; z-index:6; text-align:center;
    padding:0 8%; pointer-events:none; }
  #opCap .ln{ display:block; margin:7px 0; opacity:0; transform:translateY(10px);
    font-family:"Hiragino Mincho ProN","Yu Mincho",serif; font-weight:700;
    font-size:clamp(18px,2.5vw,30px); letter-spacing:.06em; color:#f4eede;
    text-shadow:0 2px 14px #000,0 0 26px rgba(255,210,120,.25);
    transition:opacity 1s, transform 1s; }
  #opCap .ln.in{ opacity:1; transform:translateY(0); }
  #opCap .ln.title{ font-size:clamp(34px,6vw,72px); font-weight:900; letter-spacing:.22em;
    background:linear-gradient(180deg,#fff6c8,#ffcf4d 50%,#a9741a);
    -webkit-background-clip:text;background-clip:text;color:transparent;
    text-shadow:0 0 40px rgba(255,200,70,.4); margin:14px 0 4px; }
  #opCap .ln.sub{ font-size:clamp(14px,2vw,22px); letter-spacing:.4em; color:#cdbff2; }
  #opSkip{ position:absolute; top:calc(9vh + 14px); right:20px; z-index:7;
    padding:7px 16px; border-radius:20px; font-size:13px; color:#e9e4ff;
    background:rgba(20,16,40,.7); border:1px solid #7b6bb5; cursor:pointer;
    transition:background .2s; }
  #opSkip:hover{ background:rgba(60,48,110,.9); }
  #opHintC{ position:absolute; left:0; right:0; bottom:10.5vh; z-index:6; text-align:center;
    color:#b9aee0; font-size:11px; letter-spacing:.2em; opacity:.7; pointer-events:none; }
  /* 章のシーン画像カード */
  #chapCard{ position:fixed; inset:0; z-index:150; background:#000; display:flex;
    align-items:center; justify-content:center; cursor:pointer; opacity:0; transition:opacity .6s; }
  #chapCard.show{ opacity:1; }
  #chapCard .bg{ position:absolute; inset:0; background-size:cover; background-position:center;
    opacity:.6; animation:opKenBurns 7s ease-out forwards; }
  #chapCard::after{ content:""; position:absolute; inset:0;
    background:radial-gradient(120% 90% at 50% 50%, transparent 35%, rgba(2,1,6,.8) 100%); }
  #chapCard .ttl{ position:relative; z-index:2; text-align:center; padding:0 8%; }
  #chapCard .ttl .ct{ font-family:"Hiragino Mincho ProN","Yu Mincho",serif; font-weight:900;
    font-size:clamp(24px,4.4vw,52px); letter-spacing:.08em;
    background:linear-gradient(180deg,#fff6c8,#ffcf4d 50%,#a9741a);
    -webkit-background-clip:text;background-clip:text;color:transparent;
    text-shadow:0 0 40px rgba(255,200,70,.4); }
  #chapCard .ttl .cs{ margin-top:10px; color:#cdbff2; font-size:clamp(13px,1.8vw,20px); letter-spacing:.3em; }
  /* 第2部モードカードのロック表示 */
  .modecard.locked{ filter:grayscale(.85) brightness(.5); }
  .modecard.locked .lbl .t::after{ content:" 🔒"; }
  /* ===== ビジュアルノベル会話 ===== */
  #cutscene{ position:fixed; inset:0; z-index:60; cursor:pointer; overflow:hidden; }
  #csBg{ position:absolute; inset:0; background-size:cover; background-position:center;
    transform:scale(1.05); transition:background-image .4s; }
  #csVeil{ position:absolute; inset:0; pointer-events:none;
    background:linear-gradient(180deg,rgba(6,4,14,.35) 0%,rgba(6,4,14,.1) 40%,rgba(6,4,14,.78) 100%); }
  .csSide{ position:absolute; bottom:0; width:38%; max-width:440px; height:78%;
    display:flex; align-items:flex-end; justify-content:center; pointer-events:none;
    transition:opacity .3s, filter .3s, transform .3s; }
  .csSide.left{ left:1%; } .csSide.right{ right:1%; }
  .csSide img{ max-height:100%; max-width:100%; object-fit:contain;
    -webkit-mask-image:linear-gradient(180deg,#000 78%,transparent);
    mask-image:linear-gradient(180deg,#000 78%,transparent);
    filter:drop-shadow(0 8px 26px rgba(0,0,0,.7)); }
  .csSide.left img{ transform:scaleX(1); } /* 主人公は左向き想定 */
  .csEmo{ font-size:90px; filter:drop-shadow(0 6px 16px #000); }
  .csSide.dim{ opacity:.55; filter:brightness(.6) saturate(.8); transform:translateY(6px) scale(.97); }
  .csSide.active{ opacity:1; }
  .csSide.hide{ display:none; }
  /* ドラクエ風レトロ・メッセージボックス（黒〜濃紺＋白枠＋ドット調フォント） */
  #csBox{ position:absolute; left:50%; transform:translateX(-50%); bottom:3.5%; z-index:4;
    width:min(940px,94%); display:flex; gap:14px; align-items:stretch;
    background:linear-gradient(180deg,#0a0f2a,#05071a);
    border:3px solid #fff; border-radius:8px; padding:16px 18px;
    box-shadow:0 0 0 2px #0a0f2a, 0 10px 30px rgba(0,0,0,.6), inset 0 0 18px rgba(40,60,140,.25);
    font-family:"DotGothic16","Courier New",monospace; }
  #csBox.classic{ justify-content:flex-start; }
  #csFaceWrap{ flex:0 0 auto; width:84px; height:84px; align-self:center; position:relative;
    border:2px solid #fff; border-radius:6px; background:#05071a; overflow:hidden;
    box-shadow:inset 0 0 10px rgba(40,60,140,.4); }
  #csFaceWrap.hide{ display:none; }
  #csFace{ width:100%; height:100%; object-fit:cover; object-position:top center; image-rendering:auto; }
  #csFaceEmo{ position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:46px; }
  #csBody{ flex:1; min-width:0; }
  #csName{ color:#ffe46b; font-weight:900; font-size:16px; margin-bottom:6px; letter-spacing:.06em;
    text-shadow:1px 1px 0 #000; }
  #csText{ font-size:17px; line-height:1.7; min-height:58px; color:#fff; white-space:pre-wrap;
    letter-spacing:.03em; text-shadow:1px 1px 0 #000; }
  #csText .rd{ color:#ff6a6a; }
  #csText.tremor{ animation:csTremor .12s infinite steps(2); }
  @keyframes csTremor{ 0%{transform:translate(0,0)} 50%{transform:translate(.6px,-.6px)} 100%{transform:translate(-.6px,.5px)} }
  #csBox.shake{ animation:csShake .3s ease; }
  @keyframes csShake{ 0%,100%{transform:translateX(-50%)} 25%{transform:translate(calc(-50% - 6px),2px)} 75%{transform:translate(calc(-50% + 6px),-2px)} }
  /* ===== スマホ: VN立ち絵・メッセージ枠・モーダルを画面内に収める ===== */
  @media(max-width:860px){
    /* 縦型背景に透過立ち絵を大きく配置。メッセージ枠の上に足元が来るよう底上げ */
    .csSide{ width:60%; height:58%; max-width:none; bottom:13%; }
    .csSide.left{ left:-5%; } .csSide.right{ right:-5%; }
    .csSide img{ -webkit-mask-image:linear-gradient(180deg,#000 88%,transparent);
      mask-image:linear-gradient(180deg,#000 88%,transparent); }
    .csSide.dim{ transform:translateY(4px) scale(.96); }
    .csEmo{ font-size:58px; }
    #csBox{ width:97%; bottom:2%; padding:10px 12px; gap:9px; border-width:2px; }
    #csFaceWrap{ width:54px; height:54px; }
    #csFaceEmo{ font-size:30px; }
    #csName{ font-size:13.5px; margin-bottom:3px; }
    #csText{ font-size:14px; line-height:1.55; min-height:42px; }
    /* 縦型ムービー: 黒帯を細くして縦長アートを大きく見せる */
    #opening::before,#opening::after{ height:4vh; }
    #opCap{ bottom:11vh; padding:0 6%; }
    #opCap .ln{ font-size:clamp(16px,4.3vw,26px); margin:5px 0; }
    #opCap .ln.title{ font-size:clamp(30px,9vw,58px); }
    #opCap .ln.sub{ font-size:clamp(13px,3.6vw,20px); letter-spacing:.3em; }
    #opSkip{ top:calc(4vh + 10px); right:12px; padding:6px 13px; font-size:12px; }
    #opHintC{ bottom:5.2vh; }
    #chapCard .bg{ opacity:.72; }
    .overlay .modal{ max-width:94vw; max-height:88vh; overflow:auto; }
  }
  /* 縦長画面ではムービー/カットシーン背景を必ず全面カバー（縦型アート前提） */
  @media(max-aspect-ratio:3/4){
    .opImg{ background-size:cover; background-position:center 40%; }
    #csBg{ background-position:center 38%; }
    #chapCard .bg{ background-position:center 42%; }
  }
  #csArrow{ position:absolute; right:14px; bottom:8px; color:#fff; font-size:14px; opacity:0; }
  #csArrow.on{ animation:csBlink 1s steps(2,start) infinite; }
  @keyframes csBlink{ 0%,50%{opacity:1} 50.01%,100%{opacity:0} }
  #csLogBtn{ position:absolute; right:12px; top:-14px; font-size:12px; padding:3px 9px; border-radius:6px;
    background:#0a0f2a; color:#fff; border:2px solid #fff; cursor:pointer; }
  #csChoices{ margin-top:10px; display:flex; flex-direction:column; gap:4px; }
  #csChoices.hidden{ display:none; }
  .csChoice{ color:#fff; font-size:16px; padding:3px 6px 3px 26px; position:relative; cursor:pointer;
    border-radius:4px; }
  .csChoice.sel{ background:rgba(120,90,220,.35); }
  .csChoice.sel::before{ content:"▶"; position:absolute; left:6px; color:#ffe46b; }
  /* 会話ログ（記録帳） */
  #dlgLog{ position:fixed; inset:0; z-index:120; background:rgba(2,2,8,.88); display:flex;
    align-items:center; justify-content:center; }
  #dlgLog .logbox{ width:min(760px,94%); max-height:86vh; display:flex; flex-direction:column;
    background:#05060f; border:3px solid #fff; border-radius:8px;
    font-family:"DotGothic16","Courier New",monospace; }
  #dlgLog .loghd{ display:flex; gap:8px; align-items:center; padding:12px 14px; border-bottom:2px solid #2a2f55;
    color:#ffe46b; font-weight:900; letter-spacing:.06em; }
  #dlgLog .loghd button{ margin-left:auto; font-size:12px; padding:4px 10px; background:#0a0f2a; color:#fff;
    border:2px solid #fff; border-radius:6px; cursor:pointer; }
  #dlgLog .loghd button+button{ margin-left:6px; }
  #logList{ overflow:auto; padding:10px 14px; }
  #logList .lg{ padding:7px 4px; border-bottom:1px solid #1b1f3a; color:#fff; font-size:14px; line-height:1.6; }
  #logList .lg .who{ color:#9fd0ff; font-weight:700; }
  #logList .lg.star{ background:rgba(120,90,220,.14); }
  #logList .lg .st{ color:#ffe46b; }
  #logList .empty{ color:#8a87a8; padding:20px; text-align:center; }
  #app{max-width:1320px;margin:0 auto;padding:10px;position:relative;}
  h1{font-size:20px;margin:6px 0;letter-spacing:.04em}
  .row{display:flex;gap:12px;align-items:flex-start}
  .col{display:flex;flex-direction:column;gap:8px}
  .panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px}
  button{font-family:inherit;cursor:pointer;border:1px solid var(--line);
    background:var(--panel2);color:var(--ink);border-radius:9px;padding:8px 12px;font-size:14px}
  button:hover{border-color:var(--accent)}
  button.primary{background:linear-gradient(180deg,#7b4dff,#5a2fd6);border-color:#7b4dff;font-weight:700}
  button:disabled{opacity:.4;cursor:not-allowed}
  .hidden{display:none!important}
  #board{background:#070611;border:2px solid var(--line);border-radius:10px;display:block;image-rendering:pixelated}
  #boardWrap{position:relative;max-width:100%;overflow:auto;-webkit-overflow-scrolling:touch;border-radius:10px}
  /* 脱出ボタンは下部・誤タップ防止のため十字から離して配置 */
  .gamebtns #escapeMenuBtn{font-weight:800}
  /* 脱出/撤退・SEは画面最下部の独立バーに（誤タップ防止） */
  .bottombar{border-top:1px solid var(--line);padding-top:8px;margin-top:10px}
  .bottombar button{font-size:14px;padding:11px 16px;font-weight:700}
  .bottombar #escapeMenuBtn{min-width:150px}
  .stat{display:flex;justify-content:space-between;font-size:13px;margin:2px 0}
  .bar{height:12px;background:#241c3f;border-radius:7px;overflow:hidden;border:1px solid var(--line)}
  .bar > i{display:block;height:100%}
  .pill{display:inline-block;background:var(--panel2);border:1px solid var(--line);border-radius:20px;
    padding:3px 10px;font-size:12px;margin:2px}
  #log{height:150px;overflow:auto;font-size:12.5px;line-height:1.5;background:#0b0916;
    border:1px solid var(--line);border-radius:8px;padding:8px}
  #log div{margin:1px 0}
  .l-dmg{color:var(--bad)} .l-good{color:var(--good)} .l-gold{color:var(--gold)}
  .l-sys{color:var(--muted)} .l-mag{color:var(--mp)} .l-warn{color:#ffd36b}
  .cards{display:flex;flex-wrap:wrap;gap:8px}
  /* ===== MTG風カードフレーム ===== */
  .card{
    --f1:#8a7430; --f2:#d8b54a; /* frame colors (category毎に上書き) */
    width:132px; padding:5px; cursor:pointer; text-align:left;
    border-radius:10px; position:relative;
    background:
      linear-gradient(160deg, var(--f2), var(--f1) 55%, #14101e 140%);
    border:1px solid #000;
    box-shadow:0 3px 8px rgba(0,0,0,.55), inset 0 1px 0 rgba(255,255,255,.25);
    transition:transform .12s, box-shadow .12s;
  }
  .card:hover{ transform:translateY(-4px) scale(1.03);
    box-shadow:0 8px 18px rgba(0,0,0,.6), 0 0 14px var(--f2); z-index:5; }
  .card .cname{
    display:flex; align-items:center; justify-content:space-between; gap:4px;
    background:linear-gradient(180deg,#f4ead0,#d9cba4);
    border:1px solid #00000088; border-radius:5px 5px 2px 2px;
    padding:2px 5px; margin-bottom:3px;
    font-weight:800; font-size:11px; color:#241a08;
    text-shadow:0 1px 0 rgba(255,255,255,.5);
    white-space:nowrap; overflow:hidden;
  }
  .card .cmp{
    flex:none; width:17px; height:17px; border-radius:50%;
    background:radial-gradient(circle at 35% 30%, #9bd0ff, #2a6cd0 60%, #112338);
    border:1px solid #0a1e3a;
    color:#fff; font-size:10px; font-weight:900; text-align:center; line-height:16px;
    text-shadow:0 1px 1px #000;
  }
  .card .cart{
    height:64px; border:1px solid #000000aa; border-radius:2px; overflow:hidden;
    background:radial-gradient(circle at 50% 40%, #2c2450, #120f24);
    display:flex; align-items:center; justify-content:center;
    box-shadow:inset 0 0 8px rgba(0,0,0,.6);
  }
  .card .cart img{ width:100%; height:64px; object-fit:cover; }
  .card .cart .emoji{ font-size:34px; filter:drop-shadow(0 2px 4px #000); }
  .card .ctype{
    margin-top:3px; padding:1px 5px; border-radius:3px;
    background:linear-gradient(180deg,#e7dcc0,#c9ba92);
    border:1px solid #00000066;
    font-size:9px; font-weight:700; color:#3a2c10; letter-spacing:.05em;
  }
  .card .ctext{
    margin-top:3px; min-height:30px; padding:3px 5px; border-radius:3px;
    background:linear-gradient(180deg,#efe6cf,#ddd0ad);
    border:1px solid #00000066;
    font-size:9.5px; line-height:1.3; color:#2a2010;
  }
  .card .cfoot{
    display:flex; justify-content:space-between; align-items:center;
    margin-top:3px; font-size:9.5px; font-weight:700;
    color:#f6e7b0; text-shadow:0 1px 2px #000; padding:0 2px;
  }
  .card .ccount{
    position:absolute; top:23px; left:3px; z-index:6;
    background:radial-gradient(circle at 35% 30%, #fff3b0, #d8a432 70%);
    border:1px solid #5a3c08; border-radius:50%;
    width:22px; height:22px; line-height:20px; text-align:center;
    font-size:10px; font-weight:900; color:#3a2604;
    box-shadow:0 2px 4px rgba(0,0,0,.5);
  }
  /* カテゴリ別フレーム（MTGの色対応: 回復=緑/攻撃=赤/補助=青/強化=白金/装備=アーティファクト紫灰） */
  .card.cat-heal{ --f1:#1f5c3c; --f2:#4fae74; }
  .card.cat-atk{  --f1:#6e241c; --f2:#c45040; }
  .card.cat-sup{  --f1:#1d4368; --f2:#4d8cc8; }
  .card.cat-buff{ --f1:#8a7430; --f2:#e6c45a; }
  .card.cat-equip{--f1:#4a3c5c; --f2:#9c8ab8; }
  .card.cat-gem{  --f1:#7a6b2f; --f2:#e6d45a; }
  /* ===== レアカード・ホログラム（5レイヤー） ===== */
  /* 1.ベースフレーム=レア度別の金属/宝石枠 2.イラスト枠 3.ホログラム層(虹スイープ)
     4.発光層(外周グロー) 5.演出オーバーレイ(ラメ点滅/開示フラッシュ) */
  .card.holo{ overflow:hidden; isolation:isolate; }
  .card.holo::before{ /* layer3: 斜めの虹ホログラム走査(左上→右下) */
    content:""; position:absolute; inset:-45% -15%; z-index:4; pointer-events:none;
    background:linear-gradient(115deg,
      transparent 32%, rgba(255,255,255,.28) 42%,
      rgba(255,95,160,.40) 46%, rgba(255,225,120,.40) 50%,
      rgba(110,240,170,.40) 54%, rgba(110,190,255,.40) 58%,
      rgba(190,140,255,.40) 62%, rgba(255,255,255,.28) 66%, transparent 76%);
    background-size:230% 230%; mix-blend-mode:screen;
    opacity:var(--holo,0); animation:holoSweep var(--holospd,3.4s) linear infinite; }
  .card.holo::after{ /* layer3+5: 微細ラメ/プリズム点（ゆっくり瞬く） */
    content:""; position:absolute; inset:0; z-index:5; pointer-events:none; mix-blend-mode:screen;
    background:
      radial-gradient(circle at 18% 22%, rgba(255,255,255,.6) 0 1px, transparent 2px),
      radial-gradient(circle at 68% 38%, rgba(200,235,255,.5) 0 1px, transparent 2px),
      radial-gradient(circle at 42% 72%, rgba(255,230,200,.5) 0 1px, transparent 2px),
      radial-gradient(circle at 86% 78%, rgba(255,255,255,.55) 0 1px, transparent 2px),
      radial-gradient(circle at 30% 52%, rgba(220,210,255,.45) 0 1px, transparent 2px),
      radial-gradient(circle at 78% 14%, rgba(255,255,255,.45) 0 1px, transparent 2px);
    opacity:var(--lame,0); animation:lameTwinkle 2.6s ease-in-out infinite; }
  @keyframes holoSweep{ 0%{background-position:0% 0%} 100%{background-position:200% 200%} }
  @keyframes lameTwinkle{ 0%,100%{opacity:calc(var(--lame,0)*.35)} 50%{opacity:var(--lame,0)} }
  @keyframes rarPulse{ 0%,100%{box-shadow:0 3px 8px rgba(0,0,0,.55), 0 0 7px var(--gl)}
    50%{box-shadow:0 3px 10px rgba(0,0,0,.55), 0 0 18px var(--gl), 0 0 34px var(--gl)} }
  @keyframes hueShift{ 0%{filter:hue-rotate(0deg)} 100%{filter:hue-rotate(360deg)} }
  @keyframes revFlash{ 0%{box-shadow:0 0 0 0 rgba(255,255,255,.9), 0 0 40px 20px rgba(255,255,255,.8)}
    100%{box-shadow:0 0 0 0 rgba(255,255,255,0), 0 0 0 0 rgba(255,255,255,0)} }
  .card.revflash{ animation:revFlash .6s ease-out 1; }
  /* レア度別フレーム＆発光層 */
  .card.rar-R  { --f1:#79838f; --f2:#d3dbe6; --holo:.16; --holospd:3.8s; --lame:0;  --gl:rgba(210,225,245,.55); }
  .card.rar-SR { --f1:#9a7620; --f2:#ffe08a; --holo:.30; --holospd:3.0s; --lame:.55; --gl:rgba(255,205,90,.7);
    box-shadow:0 3px 8px rgba(0,0,0,.55), 0 0 10px var(--gl); }
  .card.rar-SSR{ --holo:.44; --holospd:2.4s; --lame:.85; --gl:rgba(120,220,255,.85);
    background:linear-gradient(135deg,#ff6e9a,#ffd166 28%,#7bf0a8 52%,#6ec0ff 74%,#c08cff);
    border:1px solid #fff; animation:rarPulse 2.6s ease-in-out infinite; }
  .card.rar-UR { --holo:.52; --holospd:2.0s; --lame:1; --gl:rgba(190,120,255,.9);
    background:linear-gradient(160deg,#ffd76a,#b06bff 42%,#120a22 80%);
    border:1px solid #ffcf4d; animation:rarPulse 2.2s ease-in-out infinite; }
  .card.rar-LR { --holo:.6; --holospd:1.7s; --lame:1; --gl:rgba(255,255,255,.95);
    background:linear-gradient(135deg,#ffffff,#bfefff 22%,#ffd6f4 44%,#d6ffe0 64%,#cfe0ff 84%,#ffffff);
    border:1px solid #fff; animation:rarPulse 1.8s ease-in-out infinite, hueShift 7s linear infinite; }
  .card.rar-SSR .cname,.card.rar-LR .cname{ background:linear-gradient(180deg,#fff,#dfe7f2); }
  .card.rar-UR .cname{ background:linear-gradient(180deg,#fff0c0,#e3b85a); }
  .card.rar-SSR .cname span:first-child,.card.rar-UR .cname span:first-child,
  .card.rar-LR .cname span:first-child{ text-shadow:0 0 6px rgba(255,255,255,.75); }
  /* レアリティ・バッジ（名前バー内インライン） */
  .cname .cnm{ flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .card .crar{ flex:none; display:inline-block; font-size:8.5px; font-weight:900; line-height:13px;
    padding:0 5px; border-radius:7px; color:#1a1208; border:1px solid rgba(0,0,0,.4);
    text-shadow:0 1px 0 rgba(255,255,255,.4); box-shadow:0 1px 2px rgba(0,0,0,.5); letter-spacing:.02em; }
  .crar.r-R{background:linear-gradient(180deg,#eef3f9,#aab7c7)}
  .crar.r-SR{background:linear-gradient(180deg,#ffe9a8,#d9a93a)}
  .crar.r-SSR{background:linear-gradient(90deg,#ff8fb0,#ffe08a,#8ff0bf,#8fccff);color:#222}
  .crar.r-UR{background:linear-gradient(90deg,#ffd76a,#c08cff);color:#1a0a2a}
  .crar.r-LR{background:linear-gradient(90deg,#fff,#bfefff,#ffd6f4,#cfe0ff);color:#222}
  /* 未入手シルエット（ホロ停止） */
  .card.gunowned{ filter:grayscale(.9) brightness(.45); --holo:0; --lame:0; animation:none;
    box-shadow:0 3px 8px rgba(0,0,0,.5); }
  .card.gunowned::before,.card.gunowned::after{ display:none; }
  /* コレクション・ギャラリー */
  .modal.wide{ max-width:min(980px,96vw); width:96%; }
  .galrow{ display:flex; gap:14px; overflow-x:auto; padding:6px 2px 14px; scroll-snap-type:x proximity; }
  .galsec{ flex:none; scroll-snap-align:start; }
  .galsec h4{ position:sticky; top:0; margin:0 0 8px; padding:5px 8px; font-size:13px; border-radius:8px;
    background:linear-gradient(180deg,rgba(30,24,46,.95),rgba(20,16,32,.95)); border:1px solid var(--line);
    border-left:4px solid var(--sc,#888); }
  .galgrid{ display:grid; grid-template-columns:repeat(2,132px); gap:8px; max-height:60vh; overflow-y:auto; padding:2px 4px 4px; }
  .mpbtn{margin-top:4px;padding:2px 6px;font-size:10px;border-radius:6px;width:100%;
    background:#10243f;border:1px solid #2a4a72;color:#7cc8ff;font-weight:700}
  .mpbtn:hover{border-color:#5bb8ff;background:#16304f}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
  .tag{font-size:11px;color:var(--muted)}
  .center{text-align:center}
  .big{font-size:34px;font-weight:800;letter-spacing:.05em}
  .gold{color:var(--gold)} .muted{color:var(--muted)}
  .jobcard{flex:1;cursor:pointer;border:2px solid var(--line);border-radius:12px;padding:14px;background:var(--panel2)}
  .jobcard:hover{border-color:var(--accent)}
  .jobcard.sel{border-color:var(--gold);box-shadow:0 0 0 2px rgba(255,207,77,.25) inset}
  .controls{display:grid;grid-template-columns:repeat(3,46px);grid-template-rows:repeat(3,46px);gap:4px}
  .controls button{padding:0;font-size:18px}
  .controls button.diaglit{border-color:var(--gold);background:#33290f;color:#ffe79a}
  /* 🧭向き長押し中: 方向パッド全体を水色で強調（押すと向きだけ変わる合図） */
  .controls.facing button[data-d]{border-color:#7cc8ff;background:#16314a;color:#cfeaff;box-shadow:0 0 0 1px rgba(124,200,255,.35) inset}
  .controls.facing button#swingBtn{border-color:#7cc8ff;filter:brightness(1.1)}
  #swingBtn{border-color:var(--gold);color:#ffe79a;background:#2a230d}
  .ctrlwrap{display:flex;flex-direction:column;gap:6px}
  .actbar{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;max-width:160px}
  .actbar button{font-size:11px;padding:7px 8px;line-height:1.15;flex:1 1 auto;min-width:46px}
  .actbar button.on{border-color:var(--gold);background:#3a2f12;color:#ffe79a}
  .actbar button.holding{border-color:#7cc8ff;background:#16314a;color:#cfeaff}
  /* タッチ操作の最適化（全ボタン共通） */
  button{touch-action:manipulation;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none}
  /* 画面下に常設：タイトルへ戻るボタン（オーバーレイ類より下のz=56。会話/ムービー/モーダル時は自然に隠れる） */
  #homeBtn{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(env(safe-area-inset-bottom,0px) + 6px);
    z-index:56;font-size:12px;font-weight:800;letter-spacing:.08em;color:#e9e4ff;
    background:rgba(18,14,34,.82);border:1px solid #6b5bb0;border-radius:18px;padding:7px 16px;cursor:pointer;
    box-shadow:0 4px 14px rgba(0,0,0,.5);backdrop-filter:blur(3px)}
  #homeBtn:hover{background:rgba(50,40,92,.92);border-color:#ffd24d}
  #homeBtn.hidden{display:none}
  /* ===== モバイル（縦並び・大ボタン・キャンバス全幅） ===== */
  @media(max-width:860px){
    #app{padding:3px}
    .row{flex-direction:column;gap:7px}
    .row > .col{min-width:0!important;width:100%}
    #board{width:calc(100% * var(--bz,1));height:auto;max-width:calc(680px * var(--bz,1));margin:0 auto}
    .gamebtns button{font-size:15px;padding:12px 14px}
    #escapeMenuBtn{min-width:140px}
    .legend{display:none}
    .controls{grid-template-columns:repeat(3,64px);grid-template-rows:repeat(3,64px);gap:6px}
    .controls button{font-size:26px}
    .ctrlwrap{flex-direction:row;align-items:center;gap:12px;justify-content:center;flex-wrap:wrap}
    .actbar{max-width:none;flex:1 1 150px;min-width:150px}
    .actbar button{font-size:15px;padding:14px 10px;min-width:64px}
    #faceBtn{min-height:58px}
    /* 操作パネルを画面下部に固定しやすく：盤面の下で見やすい余白 */
    .ctrlwrap{margin:2px auto}
    #log{height:110px}
    #hand.cards{max-height:none}
  }
  .kbd{font-size:11px;color:var(--muted)}
  .legend{font-size:11px;color:var(--muted);line-height:1.6}
  .floortag{font-size:13px}
  table{border-collapse:collapse;font-size:11px;width:100%}
  td,th{border:1px solid var(--line);padding:3px 5px;text-align:center}
  .scroll{max-height:240px;overflow:auto}
  .overlay{position:fixed;inset:0;background:rgba(5,4,12,.86);display:flex;align-items:center;
    justify-content:center;z-index:120}
  .modal{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:24px;max-width:520px;width:92%}
  a{color:var(--accent)}
  .toprow{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px}
  .danger{color:var(--bad)}
  .imgnote{font-size:10.5px;color:var(--muted)}
  /* ===== モード選択の大型画像ボタン ===== */
  .modecards{display:flex;gap:20px;justify-content:center;flex-wrap:wrap;margin:8px 0 6px}
  .modecard{position:relative;width:380px;max-width:90vw;height:215px;border-radius:16px;overflow:hidden;
    cursor:pointer;border:2px solid var(--line);box-shadow:0 8px 26px rgba(0,0,0,.55);
    transition:transform .16s, box-shadow .16s, border-color .16s}
  .modecard img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .4s}
  .modecard .ov{position:absolute;inset:0;background:linear-gradient(180deg,rgba(8,6,18,.05),rgba(8,6,18,.82) 92%)}
  .modecard .lbl{position:absolute;left:0;right:0;bottom:14px;text-align:center;text-shadow:0 2px 10px #000}
  .modecard .lbl .t{font-size:24px;font-weight:900;letter-spacing:.08em;
    background:linear-gradient(180deg,#fff5c0,#ffcf4d 55%,#c08a1e);-webkit-background-clip:text;background-clip:text;color:transparent}
  .modecard .lbl .s{font-size:11px;color:#cfc8ef;letter-spacing:.1em;margin-top:2px}
  .modecard:hover{transform:translateY(-5px) scale(1.02);border-color:var(--accent);box-shadow:0 14px 34px rgba(123,77,255,.4)}
  .modecard:hover img{transform:scale(1.06)}
  .modecard.story:hover{border-color:#7b4dff}
  .modecard.free:hover{border-color:#ff9c3c}
  /* ===== ステップ・セットアップ ===== */
  .steps{display:flex;justify-content:center;gap:8px;margin:6px 0 14px;flex-wrap:wrap}
  .step{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted);
    padding:5px 12px;border-radius:20px;border:1px solid var(--line);background:rgba(20,16,38,.6)}
  .step.active{color:var(--ink);border-color:var(--gold);background:rgba(60,46,18,.5);font-weight:700}
  .step.done{color:var(--good);border-color:#2f6b4f}
  .step .n{display:inline-flex;width:20px;height:20px;border-radius:50%;align-items:center;justify-content:center;
    font-size:11px;background:#2a2350;border:1px solid var(--line)}
  .step.active .n{background:var(--gold);color:#241a08}
  .stepPanel{animation:fadeUp .25s ease}
  @keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
  .navrow{display:flex;justify-content:space-between;align-items:center;margin-top:14px;gap:10px}
  .pickbig{cursor:pointer;border:2px solid var(--line);border-radius:14px;background:linear-gradient(180deg,var(--panel2),var(--panel));
    padding:14px;text-align:center;transition:transform .12s,border-color .12s,box-shadow .12s;flex:1;min-width:180px}
  .pickbig:hover{transform:translateY(-4px);border-color:var(--accent);box-shadow:0 8px 20px rgba(123,77,255,.3)}
  .pickbig.sel{border-color:var(--gold);box-shadow:0 0 0 2px rgba(255,207,77,.3) inset, 0 8px 20px rgba(255,180,60,.25)}
  /* ===== タイトルメニュー（PUSH START → 4択） ===== */
  #titleMenu{position:fixed;inset:0;z-index:60;display:flex;flex-direction:column;align-items:center;justify-content:center;
    background:radial-gradient(circle at 50% 32%,#1a1430,#08060f 78%);overflow:hidden}
  #titleMenu.hidden{display:none}
  #titleMenu .tmbg{position:absolute;inset:0;background:url('assets/title_key.png') center/cover no-repeat;opacity:.5;
    filter:saturate(1.1) contrast(1.05)}
  #titleMenu .tmbg.alt{background-image:url('assets/title_mirage.png')}
  #titleMenu .tmvig{position:absolute;inset:0;background:radial-gradient(circle at 50% 40%,rgba(8,6,15,0),rgba(8,6,15,.85) 95%)}
  #titleMenu .tmlogo{position:relative;z-index:2;text-align:center;margin-bottom:24px;text-shadow:0 4px 24px #000}
  #titleMenu .tmlogo .t1{font-size:clamp(34px,7vw,68px);font-weight:900;letter-spacing:.06em;
    background:linear-gradient(180deg,#fff6cf,#ffcf4d 52%,#bb841c);-webkit-background-clip:text;background-clip:text;color:transparent;
    filter:drop-shadow(0 2px 10px rgba(255,180,60,.35))}
  #titleMenu .tmlogo .t2{font-size:clamp(11px,2vw,15px);letter-spacing:.42em;color:#cbb9ff;margin-top:4px}
  #pushStart{position:relative;z-index:2;font-size:clamp(16px,3vw,24px);font-weight:800;letter-spacing:.34em;color:#fff;
    text-shadow:0 0 14px rgba(255,210,120,.8);animation:pushBlink 1.15s ease-in-out infinite;cursor:pointer;
    border:2px solid rgba(255,210,120,.5);border-radius:40px;padding:12px 34px;background:rgba(20,14,34,.4)}
  #pushStart:hover{border-color:#ffd24d}
  @keyframes pushBlink{0%,100%{opacity:1}50%{opacity:.32}}
  #mainMenu{position:relative;z-index:2;display:none;flex-direction:column;gap:11px;width:min(340px,86vw);margin-top:6px}
  #mainMenu.show{display:flex;animation:fadeUp .3s ease}
  .mmbtn{display:flex;align-items:center;gap:12px;padding:13px 20px;border-radius:12px;cursor:pointer;
    border:1px solid rgba(255,255,255,.16);background:linear-gradient(100deg,rgba(40,30,66,.92),rgba(22,16,38,.92));
    box-shadow:0 4px 14px rgba(0,0,0,.4);transition:transform .12s,border-color .12s,box-shadow .12s}
  .mmbtn:hover{transform:translateX(5px);border-color:var(--gold);box-shadow:0 6px 20px rgba(255,180,60,.28)}
  .mmbtn .mi{font-size:24px;width:30px;text-align:center}
  .mmbtn .mt{font-size:18px;font-weight:900;letter-spacing:.12em;color:#ffe9b0}
  .mmbtn .md{font-size:10.5px;color:#b9aee0;letter-spacing:.04em}
  .mmbtn.dis{opacity:.5;cursor:not-allowed}
  .mmbtn.dis:hover{transform:none;border-color:rgba(255,255,255,.16);box-shadow:0 4px 14px rgba(0,0,0,.4)}
  /* ===== ワールドマップ ===== */
  #worldWrap{display:none}
  #worldWrap.show{display:block;animation:fadeUp .3s ease}
  .wmtop{display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-bottom:6px}
  .wmboard{position:relative;width:100%;max-width:760px;height:430px;margin:0 auto;border-radius:14px;overflow:hidden;
    border:1px solid var(--line);background:#0c0a18}
  .wmboard .wmbg{position:absolute;inset:0;background-size:cover;background-position:center;opacity:.55}
  .wmboard svg.wmedges{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
  .castle{position:absolute;transform:translate(-50%,-50%);width:62px;text-align:center;cursor:pointer;z-index:2}
  .castle .cico{font-size:30px;line-height:1;filter:drop-shadow(0 2px 4px #000);transition:transform .12s}
  .castle .cnmlbl{font-size:9px;font-weight:800;color:#fff;text-shadow:0 1px 3px #000;white-space:nowrap;margin-top:1px;
    letter-spacing:.02em}
  .castle .cfloors{font-size:8px;color:#ffe9b0;text-shadow:0 1px 2px #000}
  .castle .cdot{position:absolute;top:-3px;right:8px;font-size:13px}
  .castle.locked{opacity:.32;filter:grayscale(.7);cursor:default}
  .castle.attackable .cico{animation:castlePulse 1.1s ease-in-out infinite}
  .castle.attackable{cursor:pointer}
  .castle.owned .cico{}
  .castle:not(.locked):hover .cico{transform:scale(1.18)}
  @keyframes castlePulse{0%,100%{transform:scale(1);filter:drop-shadow(0 0 0 rgba(255,220,120,0))}
    50%{transform:scale(1.16);filter:drop-shadow(0 0 10px rgba(255,220,120,.95))}}
  .cyellow .cico{color:#ffd84a}.cgreen .cico{color:#7be08a}.cblue .cico{color:#7fb4ff}
  .cred .cico{color:#ff7a6e}.cgold .cico{color:#ffe07a}.cfort .cico{color:#ffffff}
  /* 城の外観画像（難易度で大きさ可変・絵文字フォールバック） */
  .castle .cimg{display:block;margin:0 auto;object-fit:contain;
    filter:drop-shadow(0 3px 5px rgba(0,0,0,.7));transition:transform .12s}
  .castle:not(.locked):hover .cimg{transform:scale(1.1)}
  .castle.locked .cimg{filter:grayscale(.85) brightness(.45) drop-shadow(0 2px 4px #000)}
  .castle.attackable .cimg{animation:castleImgPulse 1.2s ease-in-out infinite}
  @keyframes castleImgPulse{0%,100%{filter:drop-shadow(0 3px 5px rgba(0,0,0,.7))}
    50%{filter:drop-shadow(0 0 12px rgba(255,220,120,.95)) drop-shadow(0 3px 5px rgba(0,0,0,.7))}}
  .wmlegend{font-size:10.5px;color:var(--muted);text-align:center;margin-top:6px;line-height:1.7}
  /* ===== VS アリーナ ===== */
  .vsfield{display:flex;justify-content:space-between;gap:10px;margin:6px 0}
  .vsside{flex:1;border:1px solid var(--line);border-radius:12px;padding:10px;background:var(--panel2);text-align:center}
  .vsside.me{border-color:#5bb8ff}.vsside.cpu{border-color:#ff7a6e}
  .vshpbar{height:14px;border-radius:8px;background:#1a1430;overflow:hidden;margin:5px 0;border:1px solid #00000066}
  .vshpfill{height:100%;transition:width .4s}
  .vsname{font-weight:900;letter-spacing:.06em}.vsnum{font-size:12px;color:var(--muted)}
  .vsvs{align-self:center;font-size:24px;font-weight:900;color:var(--gold)}
  .vslog{font-size:11.5px;line-height:1.6;max-height:90px;overflow:auto;border:1px solid var(--line);border-radius:8px;
    padding:6px;background:rgba(10,8,22,.6);margin:6px 0}
  /* ===== OPTION ===== */
  .optrow{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:9px 2px;border-bottom:1px solid var(--line)}
  .optrow label{font-size:13px;font-weight:700}
  .optrow .od{font-size:10.5px;color:var(--muted)}
  .optrow input[type=range]{width:150px}
  .segbtn{display:inline-flex;gap:4px}
  .segbtn button{font-size:11px;padding:3px 9px;border-radius:7px}
  .segbtn button.on{border-color:var(--gold);color:var(--gold);background:rgba(60,46,18,.5)}
  /* ===== 本格スロットマシン筐体 ===== */
  .modal.slotcab{ border:3px solid #d9a93a; box-shadow:0 0 0 3px #4a3410, 0 18px 46px rgba(0,0,0,.75); max-width:430px;
    background:linear-gradient(180deg,rgba(20,10,36,.80),rgba(10,6,20,.90)),
      url('assets/slot_cabinet.png') center/cover no-repeat,
      linear-gradient(180deg,#2c1a44,#150a24); }
  .slmarquee{ text-align:center; font-weight:900; letter-spacing:.12em; font-size:17px; padding:8px 10px; border-radius:12px;
    background:linear-gradient(180deg,#ff3b6b,#b81e48); color:#fff; text-shadow:0 0 10px #ffd24d,0 2px 0 #000;
    border:2px solid #ffd24d; box-shadow:0 0 18px rgba(255,90,120,.55), inset 0 0 12px rgba(255,255,255,.3);
    position:relative; overflow:hidden; }
  .slmarquee::before,.slmarquee::after{ content:"●●●●●●●●●●●●"; position:absolute; left:0; right:0; font-size:7px;
    letter-spacing:4px; color:#ffe46b; text-shadow:0 0 6px #ffd24d; text-align:center; animation:slbulb .8s steps(2) infinite; }
  .slmarquee::before{ top:1px } .slmarquee::after{ bottom:1px }
  @keyframes slbulb{ 0%{opacity:1} 50%{opacity:.35} }
  .slwindow{ position:relative; margin:12px auto 6px; padding:12px 14px; border-radius:14px; width:max-content;
    background:linear-gradient(180deg,#3a2a10,#1c1208); border:4px solid #e0b347;
    box-shadow:inset 0 2px 16px rgba(0,0,0,.85), 0 0 0 3px #5a3c10; }
  .slwindow .slpay{ position:absolute; top:8px; bottom:34px; display:flex; flex-direction:column; justify-content:space-around;
    font-size:10px; font-weight:900; color:#ffd24d; text-shadow:0 1px 2px #000; }
  .slwindow .slpay.l{ left:-4px } .slwindow .slpay.r{ right:-4px }
  .slreel{ display:flex; gap:8px; justify-content:center; padding:8px; border-radius:8px;
    background:linear-gradient(180deg,rgba(8,8,26,.45),rgba(4,4,16,.6)),
      url('assets/slot_reelbg.png') center/cover no-repeat,
      linear-gradient(180deg,#0c1030,#04061a); border:2px solid #9aa3c0;
    box-shadow:inset 0 0 14px rgba(0,0,0,.9); }
  .sllever{ font-size:16px; font-weight:900; padding:10px 30px; border-radius:30px; cursor:pointer;
    background:radial-gradient(circle at 40% 28%,#ff8a7e,#c0182f); color:#fff; border:3px solid #ffd24d;
    box-shadow:0 6px 0 #7a0f1e,0 9px 16px rgba(0,0,0,.5); text-shadow:0 1px 2px #000; letter-spacing:.08em; }
  .sllever:active{ transform:translateY(3px); box-shadow:0 3px 0 #7a0f1e; }
  .sltray{ margin:8px auto 0; width:78%; height:13px; border-radius:0 0 12px 12px;
    background:linear-gradient(180deg,#2a2a32,#08080c); border:2px solid #555; border-top:none;
    box-shadow:inset 0 3px 6px rgba(0,0,0,.8); }
  .slcoin{ display:inline-block; padding:2px 10px; border-radius:14px; font-weight:900; color:#3a2604;
    background:radial-gradient(circle at 35% 30%,#fff3b0,#d8a432 72%); border:1px solid #5a3c08; }
</style>
</head>
<body>
<div id="app">
  <div class="toprow">
    <h1>⚔️ ミラージュゲート <span class="tag">— MIRAGE GATE / roguelike × medal × cards</span></h1>
    <div id="meta" class="floortag muted"></div>
  </div>

  <!-- ===== TITLE / SETUP ===== -->
  <div id="setup" class="panel">
    <div id="bannerWrap" style="position:relative;border-radius:12px;overflow:hidden;margin-bottom:12px;border:1px solid var(--line)">
      <img src="assets/title_key.png" alt="ミラージュゲート — MIRAGE GATE" onerror="this.onerror=null;this.src='assets/title_mirage.png'" style="width:100%;display:block;aspect-ratio:1152/640;object-fit:cover">
      <div style="position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,rgba(8,6,18,0),rgba(8,6,18,0) 70%,rgba(8,6,18,.55) 100%)"></div>
      <div style="position:absolute;left:0;right:0;bottom:8px;text-align:center;pointer-events:none">
        <div class="muted" style="font-size:11px;letter-spacing:.3em;text-shadow:0 2px 6px #000">PUSH START — ダンジョン探索ロールプレイング</div>
      </div>
    </div>
    <!-- ===== モード選択（大型画像ボタン） ===== -->
    <div id="modePick" class="center" style="margin:4px 0 6px">
      <div class="modecards">
        <div class="modecard story" id="storyBtn">
          <img src="assets/ui_story.png" alt="ストーリー">
          <div class="ov"></div>
          <div class="lbl"><div class="t">📖 ストーリーモード</div><div class="s">封印カードの迷宮 — 妹を巡る物語</div></div>
        </div>
        <div class="modecard free" id="freeBtn">
          <img src="assets/ui_free.png" alt="フリープレイ">
          <div class="ov"></div>
          <div class="lbl"><div class="t">⚔️ フリープレイ</div><div class="s">好きな職業・ダンジョンで挑戦</div></div>
        </div>
        <div class="modecard story2 locked" id="story2Btn">
          <img src="assets/s2_blacksquad.png" alt="第2部">
          <div class="ov"></div>
          <div class="lbl"><div class="t">📖II 第2部：探索者試験編</div><div class="s s2note">🔒 第1部をクリアすると解放</div></div>
        </div>
        <div class="modecard free" id="worldBtn">
          <img src="assets/title_key.png" alt="ワールド" onerror="this.onerror=null;this.src='assets/ui_free.png'">
          <div class="ov"></div>
          <div class="lbl"><div class="t">🗺️ ワールドモード</div><div class="s">全5エリア・49城を占領せよ — 陣取りローグライク</div></div>
        </div>
      </div>
      <div style="margin-top:8px">
        <button id="slotBtn" class="hidden" style="font-size:13px;padding:6px 14px;margin:3px">🎰 スロット</button>
        <button id="galleryBtn" style="font-size:13px;padding:6px 14px;margin:3px">🗂️ コレクション一覧</button>
        <button id="dexBtn" style="font-size:13px;padding:6px 14px;margin:3px">📚 カード図鑑</button>
        <button id="titleBtn" style="font-size:13px;padding:6px 14px;margin:3px">🏆 称号</button>
        <button id="bazaarBtn" style="font-size:13px;padding:6px 14px;margin:3px">🦅 クロウの闇市</button>
        <button id="openingBtn" style="font-size:13px;padding:6px 14px;margin:3px">🎬 オープニング</button>
        <button id="logBtn2" style="font-size:13px;padding:6px 14px;margin:3px">📜 会話ログ</button>
        <button id="demoBtn" style="font-size:13px;padding:6px 14px;margin:3px">💬 会話デモ</button>
      </div>
      <div class="muted" style="font-size:11px;margin-top:6px" id="storyProg"></div>
    </div>

    <!-- ===== ステップ式セットアップ ===== -->
    <div id="freeSetup" class="hidden">
      <div id="storyDunNote" class="center gold hidden" style="margin:2px 0 8px;font-weight:700"></div>
      <div class="steps">
        <div class="step" data-s="0"><span class="n">1</span>職業</div>
        <div class="step" data-s="1"><span class="n">2</span>ダンジョン</div>
        <div class="step" data-s="2"><span class="n">3</span>デッキ</div>
      </div>

      <!-- STEP 1: 職業 -->
      <div id="step0" class="stepPanel hidden">
        <h3 class="center">① 職業を選ぶ</h3>
        <div class="row" id="jobpick"></div>
        <div class="navrow"><button id="back0">◀ もどる</button><button class="primary" id="next0">つぎへ ▶</button></div>
      </div>

      <!-- STEP 2: ダンジョン -->
      <div id="step1" class="stepPanel hidden">
        <h3 class="center">② ダンジョンを選ぶ</h3>
        <div class="grid3" id="dunpick"></div>
        <div class="navrow"><button id="back1">◀ もどる</button><button class="primary" id="next1">つぎへ ▶</button></div>
      </div>

      <!-- STEP 3: デッキ（所持カードから持ち込む） -->
      <div id="step2" class="stepPanel hidden">
        <h3 class="center">③ 持ち込むカードを選ぶ</h3>
        <p class="tag center">所持メダル: <span id="medals" class="gold">2000</span> ／ <b>自分の所持カードから</b>最大 <span id="bagmax">10</span> 枚まで持ち込めます。<b class="danger">死ぬと持ち込んだカードを失う。</b><br>
        カードは、ダンジョンで拾う・高難度ダンジョン内の<b>売店</b>・<b>スロット</b>で増やせます。</p>
        <div class="row">
          <div class="col" style="flex:1.6">
            <div class="tag">📚 コレクション（所持カード・クリックで袋へ）</div>
            <div id="collection" class="cards" style="min-height:120px;max-height:240px;overflow:auto;border:1px dashed var(--line);border-radius:8px;padding:6px"></div>
          </div>
          <div class="col" style="flex:1.2">
            <div class="tag">👝 袋 <span id="bagcount">0</span>/10（クリックで戻す）</div>
            <div id="bag" class="cards" style="min-height:120px;border:1px dashed var(--gold);border-radius:8px;padding:6px"></div>
            <div class="tag">入場BET: <span id="bet" class="gold">0</span> メダル</div>
          </div>
        </div>
        <div id="shop" class="hidden"></div>
        <div class="navrow"><button id="back2">◀ もどる</button>
          <button class="primary" id="startBtn" style="font-size:16px;padding:10px 26px">ダンジョンへ潜る ▶</button></div>
      </div>
    </div><!-- /freeSetup -->
  </div>

  <!-- ===== CUTSCENE (VN dialogue) ===== -->
  <div id="cutscene" class="hidden">
    <div id="csBg"></div>
    <div id="csVeil"></div>
    <div class="csSide left" id="csHeroSide"><span class="csEmo" id="csHeroEmo"></span><img id="csHero" alt=""></div>
    <div class="csSide right" id="csPartnerSide"><span class="csEmo" id="csPartnerEmo"></span><img id="csPartner" alt=""></div>
    <div id="csBox">
      <div id="csFaceWrap"><img id="csFace" alt=""><span id="csFaceEmo"></span></div>
      <div id="csBody">
        <div id="csName"></div>
        <div id="csText"></div>
        <div id="csChoices" class="hidden"></div>
      </div>
      <div id="csArrow">▼</div>
      <button id="csLogBtn" title="会話ログ（X）">📜</button>
    </div>
  </div>

  <!-- ===== 会話ログ（記録帳） ===== -->
  <div id="dlgLog" class="hidden">
    <div class="logbox">
      <div class="loghd">📜 会話ログ <button id="logOrder">新しい順 ⇅</button><button id="logClose">とじる（Esc）</button></div>
      <div id="logList"></div>
    </div>
  </div>

  <!-- ===== OPENING CINEMATIC ===== -->
  <div id="opening" class="hidden">
    <div id="opA" class="opImg"></div>
    <div id="opB" class="opImg"></div>
    <div id="opVig"></div>
    <div id="opCap"></div>
    <div id="opHintC">クリック / Enter で進む</div>
    <div id="opSkip">スキップ ▶</div>
  </div>

  <!-- ===== タイトルメニュー（PUSH START → 4択） ===== -->
  <div id="titleMenu" class="hidden">
    <div class="tmbg"></div><div class="tmvig"></div>
    <div class="tmlogo"><div class="t1">⚔ ミラージュゲート</div><div class="t2">MIRAGE GATE</div></div>
    <div id="pushStart">PUSH START</div>
    <div id="mainMenu">
      <div class="mmbtn" data-act="continue"><span class="mi">▶</span><span><span class="mt">CONTINUE</span><br><span class="md">続きから（セーブデータで遊ぶ）</span></span></div>
      <div class="mmbtn" data-act="new"><span class="mi">✦</span><span><span class="mt">NEW GAME</span><br><span class="md">最初から始める</span></span></div>
      <div class="mmbtn" data-act="vs"><span class="mi">⚔</span><span><span class="mt">VS BATTLE</span><br><span class="md">CPU対戦アリーナ</span></span></div>
      <div class="mmbtn" data-act="option"><span class="mi">⚙</span><span><span class="mt">OPTION</span><br><span class="md">音量・文字送り・セーブ・画面設定</span></span></div>
    </div>
  </div>

  <!-- ===== ワールドモード ===== -->
  <div id="worldWrap" class="panel">
    <div class="wmtop">
      <button id="wmBack">◀ タイトル</button>
      <div style="text-align:center;flex:1">
        <div style="font-size:18px;font-weight:900;letter-spacing:.06em" class="gold">🗺️ ワールドモード</div>
        <div class="muted" style="font-size:11px" id="wmAreaName">エリア 1/5</div>
      </div>
      <div style="text-align:right;font-size:11px" class="muted">占領 <b class="gold" id="wmOwned">0</b>/<span id="wmTotal">0</span></div>
    </div>
    <div class="wmboard" id="wmBoard"><div class="wmbg" id="wmBg"></div><svg class="wmedges" id="wmEdges" preserveAspectRatio="none"></svg></div>
    <div class="wmlegend">🏰白=砦　🟡黄城=低　🟢緑城=中　🔵青城=高　🔴赤城=ボス　🟨金城=隠し最難関　／　光る城=攻略可能　🛡️=ガーディアン配置済み</div>
    <div class="center" style="margin-top:8px">
      <button id="wmArea">◀ 前のエリア</button>
      <button id="wmArea2">次のエリア ▶</button>
    </div>
  </div>

  <!-- ===== chapter scene card ===== -->
  <div id="chapCard" class="hidden"><div class="bg"></div>
    <div class="ttl"><div class="ct"></div><div class="cs"></div></div></div>

  <!-- ===== ending choice ===== -->
  <div id="choice" class="overlay hidden"><div class="modal" id="choiceModal"></div></div>

  <!-- ===== GAME ===== -->
  <div id="game" class="hidden">
    <div class="row">
      <div class="col" style="position:relative">
        <div id="boardWrap"><canvas id="board" width="780" height="672"></canvas></div>
        <div id="tutToast"></div>
        <div class="panel" style="padding:8px">
          <div class="row" style="align-items:center;justify-content:space-between">
            <div class="ctrlwrap">
              <div class="controls">
                <button data-d="7">↖</button><button data-d="8">↑</button><button data-d="9">↗</button>
                <button data-d="4">←</button><button data-d="5" id="swingBtn" title="その場で剣を振る">🗡</button><button data-d="6">→</button>
                <button data-d="1">↙</button><button data-d="2">↓</button><button data-d="3">↘</button>
              </div>
              <div class="actbar">
                <button id="faceBtn" title="押している間だけ：矢印で向きだけ変更（移動しない）">🧭向き<br><small>長押し</small></button>
                <button id="diagBtn" title="ON中は十字ボタンが斜め移動になる">⤡斜め</button>
                <button id="cardBtn" title="手札カードを開く">🎴カード</button>
              </div>
            </div>
            <div class="legend">
              移動/攻撃: 矢印・テンキー・WASD（QEZC=斜め）<br>
              <b>🗡</b>=その場で剣を振る（向き方向／敵がいれば斬る）　<b>🧭向き</b>=長押し中は向きだけ変更<br>
              <b>⤡斜め</b>=十字で斜め移動　<b>🎴カード</b>=手札を開く<br>
              <span class="gold">▼NEXT階段</span>で次へ / <span style="color:#7befff">▲階段</span>で前の階へ（1Fなら入口脱出）
            </div>
          </div>
          <div class="row gamebtns" style="justify-content:flex-end;gap:8px;margin-top:10px;flex-wrap:wrap">
            <button id="summonBtn" title="仲間モンスターを召喚">👹 召喚</button>
            <button id="zoomBtn" title="ダンジョン表示を拡大/標準に切替">🔍 拡大</button>
          </div>
        </div>
      </div>

      <div class="col" style="flex:1;min-width:300px">
        <div class="panel">
          <div class="toprow">
            <b id="jobName">—</b>
            <span class="floortag"><span id="dunName"></span> <span class="gold" id="floorNo"></span></span>
          </div>
          <div class="row" style="align-items:center;gap:10px;margin:6px 0">
            <img id="avatar" alt="hero" style="height:74px;width:74px;object-fit:contain;
              background:radial-gradient(circle at 50% 40%,#2a2350,#120f24);border:1px solid var(--line);
              border-radius:10px;filter:drop-shadow(0 2px 6px rgba(0,0,0,.5))">
            <div style="flex:1">
          <div class="stat"><span>Lv <b id="lv">1</b> <span class="tag">(上限 <span id="lvcap">50</span>)</span></span><span class="tag">ATK <b id="atk">0</b> / DEF <b id="def">0</b></span></div>
          <div class="stat"><span class="danger">HP</span><span><b id="hp">0</b>/<b id="maxhp">0</b></span></div>
          <div class="bar"><i id="hpbar" style="background:linear-gradient(90deg,#ff5b6e,#ff9ba6);width:100%"></i></div>
          <div class="stat"><span style="color:var(--mp)">MP</span><span><b id="mp">0</b>/<b id="maxmp">0</b></span></div>
          <div class="bar"><i id="mpbar" style="background:linear-gradient(90deg,#2a6cd0,#7cc8ff);width:100%"></i></div>
            </div>
          </div>
          <div class="stat" style="margin-top:6px"><span class="gold">所持メダル</span><b class="gold" id="curMedals">0</b></div>
          <div class="stat"><span class="gold">このランの宝石/配当</span><b class="gold" id="loot">0</b></div>
          <div class="stat"><span>状態</span><span id="status" class="tag">—</span></div>
        </div>

        <div class="panel">
          <div class="toprow"><b>手札カード</b><span class="tag">枠 <span id="handCount">0</span>/<span id="handMax">10</span></span></div>
          <div id="equipBar" class="tag" style="margin:2px 0;color:#ffe09a"></div>
          <div class="center" style="margin:4px 0"><button id="handToggle" style="padding:7px 18px;font-size:13px">🎴 カード一覧をひらく</button></div>
          <div id="hand" class="cards hidden" style="min-height:0"></div>
          <div class="imgnote" id="cardhint">「カード一覧をひらく」で手札を表示→クリックで使用（MP消費・1ターン）。単体攻撃は最寄りの敵へ自動照準。「→MP」で不要カードをMP変換（行動消費なし）。</div>
        </div>

        <div class="panel">
          <div class="toprow"><b>ログ</b>
            <span><button id="guideBtn" style="padding:4px 8px;font-size:12px">戦術ガイド</button>
            <button id="capBtn" style="padding:4px 8px;font-size:12px">敵レベル上限表</button></span>
          </div>
          <div id="log"></div>
        </div>
      </div>
    </div>
    <div class="row bottombar" style="justify-content:center;gap:12px;margin-top:8px;padding-bottom:6px">
      <button id="sndBtn" title="効果音 ON/OFF">🔊 SE</button>
      <button id="escapeMenuBtn" class="danger">🚪 脱出 / 撤退</button>
    </div>
  </div>
</div>

<!-- ===== modal mount ===== -->
<div id="overlay" class="overlay hidden"><div class="modal" id="modal"></div></div>

<script>
/* =========================================================================
   MONSTER GATE — fan game. Single file. Image-swap hooks included.
   ========================================================================= */

/* ---- SPRITE REGISTRY (AI-image swap hook) ----------------------------
   You can later drop generated PNGs into an "assets/" folder next to this
   file and register them here, e.g.:
       SPRITES.player = "assets/warrior.png";
       SPRITES.mon["ドラゴン"] = "assets/dragon.png";
   If an image path is set & loads, it's drawn instead of the emoji.
----------------------------------------------------------------------- */
const SPRITES = { player:null, stairs:null, gem:null, mon:{} };
// Hero portraits per job (AI-generated, background removed)
const HERO_SPRITE = { warrior:"assets/t_hero_warrior.png", mage:"assets/t_hero_wizard.png", gambler:"assets/t_hero_gambler.png", ren:"assets/t_hero_ren.png" };
// Each monster now has its own dedicated generated sprite.
const MON_SPRITE = {
  "プーニャ緑":"assets/t_mon_slime.png","プーニャ黄":"assets/t_mon_slime.png",
  "リザード":"assets/t_mon_lizard.png","ベノム":"assets/t_mon_venom.png",
  "キラービー":"assets/t_mon_bee.png","キラービー群":"assets/t_mon_bee.png","マザービー":"assets/t_mon_queenbee.png",
  "ケムンパ":"assets/t_mon_caterpillar.png","スピット":"assets/t_mon_spit.png",
  "ホッピー":"assets/t_mon_hoppy.png","キラーホッピー":"assets/t_mon_hoppy.png",
  "スケルトン":"assets/t_mon_skeleton.png","死神":"assets/t_mon_reaper.png",
  "魔道士":"assets/t_mon_mage.png","プリースト":"assets/t_mon_priest.png","ビショップ":"assets/t_mon_priest.png",
  "リスタール":"assets/t_mon_golem.png","エビルアイ":"assets/t_mon_evileye.png",
  "ドラゴン":"assets/t_mon_dragon.png","グランシャーク":"assets/t_mon_shark.png","リスタドラゴン":"assets/t_mon_darkdragon.png",
  "キングドラゴン":"assets/t_mon_kingdragon.png","カオス":"assets/t_mon_chaos.png",
  "ゴブリン":"assets/t_mon_goblin.png","バルチャー":"assets/t_mon_vulture.png","ターミネーター":"assets/t_mon_robot.png",
  "マッドブル":"assets/t_mon_madbull.png","デーモン":"assets/t_mon_demon.png",
  "ミミック":"assets/t_mon_mimic.png","レイス":"assets/t_mon_wraith.png","クリスタルゴーレム":"assets/t_mon_crystalgolem.png",
  "幻影のオーブ":"assets/t_mon_orb.png",
};
/* ---- 8方向・状態別スプライト ----
   正面(front)/背面(back)/横(side) × 待機(idle)/攻撃(attack)/被弾(hit) の9枚セット。
   8方向は「縦成分で front/back、横成分は side+左右反転」で表現する。
   セットが無いキャラは従来の1枚スプライトにフォールバック。 */
function dset(p){
  const v=(vw,st)=>`assets/t_d_${p}_${vw}_${st}.png`;
  const mk=(vw)=>({idle:v(vw,'idle'),attack:v(vw,'attack'),hit:v(vw,'hit'),walk:v(vw,'walk'),atkwind:v(vw,'atkwind')});
  return {front:mk('front'),back:mk('back'),side:mk('side'),
          fdiag:mk('fdiag'),bdiag:mk('bdiag')}; // 斜め前/斜め後ろ(右向き基準・左は反転)
}
const DIR_SPRITES={
  hero_warrior:dset('warrior'), hero_mage:dset('wizard'), hero_gambler:dset('gambler'), hero_ren:dset('ren'),
  "プーニャ緑":dset('slime'), "プーニャ黄":dset('slime'),
  "スケルトン":dset('skeleton'), "ゴブリン":dset('goblin'), "ドラゴン":dset('dragon'),
  // 全モンスター方向対応（正面/背面/横の待機を生成済み。攻撃/被弾はm2ポーズ、斜めは前後にフォールバック）
  "ホッピー":dset('hoppy'), "キラーホッピー":dset('hoppy'), "リザード":dset('lizard'),
  "ケムンパ":dset('caterpillar'), "キラービー":dset('bee'), "キラービー群":dset('bee'),
  "マザービー":dset('queenbee'), "スピット":dset('spit'), "魔道士":dset('mage'),
  "プリースト":dset('priest'), "ビショップ":dset('priest'), "リスタール":dset('golem'),
  "バルチャー":dset('vulture'), "グランシャーク":dset('shark'), "ターミネーター":dset('robot'),
  "死神":dset('reaper'), "マッドブル":dset('madbull'), "ベノム":dset('venom'),
  "エビルアイ":dset('evileye'), "リスタドラゴン":dset('darkdragon'),
  "キングドラゴン":dset('kingdragon'), "デーモン":dset('demon'), "カオス":dset('chaos'),
  "ミミック":dset('mimic'), "レイス":dset('wraith'), "クリスタルゴーレム":dset('crystalgolem'),
};
function dirSprite(key,e){
  const set=DIR_SPRITES[key]; if(!set) return null;
  const dx=e._dirX||0, dy=e._dirY||0;
  // 状態選択。攻撃中は「振りかぶり(atkwind)→振り抜き(attack)」の2コマで滑らかに。
  let state;
  if(e._lunge){
    const lt=(now()-e._lunge.t0)/300; // lungeと同じ尺
    state = (lt<0.45) ? 'atkwind' : 'attack';
  }
  else if(e._hit) state='hit';
  else if(e._moving) state=((now()/140|0)%2)?'walk':'idle';
  else state='idle';
  // 8方向: 斜めは fdiag/bdiag、左向きは反転
  let view, flip=1;
  if(dx&&dy){
    if(key && key.indexOf('hero_')===0){ view='side'; flip=dx>0?1:-1; } // レンの斜めは横向き画像で自然に（生成斜めは不自然なため）
    else { view = dy>0 ? 'fdiag' : 'bdiag'; flip = dx>0?1:-1; }
  }
  else if(dy<0){ view='back'; }
  else if(dy>0){ view='front'; }
  else { view='side'; flip=(e._face||1); } // 横向きスプライトは右向き基準。右(_face=1)はそのまま、左は反転
  // 横向き/斜め向きは idle と walk のスプライトが左右逆を向いているため、歩行フレームを使わない
  // （使うと移動中に1コマだけ反転してチラつく）。front/back は反転を使わないので walk のまま。
  if(state==='walk' && view!=='front' && view!=='back') state='idle';
  let path=set[view]&&set[view][state];
  let im=path?getImg(path):null;
  if(!(im&&im._ok) && state==='walk'){ // walk未ロード時はidleで代用
    path=set[view]&&set[view].idle; im=path?getImg(path):null;
  }
  if(!(im&&im._ok) && state==='atkwind'){ // 振りかぶり未ロード時はattackで代用
    state='attack'; path=set[view]&&set[view].attack; im=path?getImg(path):null;
  }
  if(!(im&&im._ok)){
    // 斜め/状態画像が無い場合は縦成分ビュー→idleの順にフォールバック
    const fb = dy<0?'back' : dy>0?'front' : 'side';
    let ok=false;
    for(const st2 of [state,'idle']){
      path=set[fb][st2]; im=path?getImg(path):null;
      if(im&&im._ok){ ok=true; break; }
    }
    flip = fb==='side' ? (e._face||1) : 1;
    if(!ok){
      // 状態専用画像が無ければ null → m2ポーズ/従来スプライトへ
      if(state==='attack'||state==='hit') return null;
      return null;
    }
    // attack/hit中にidleしか無い場合はm2ポーズを優先させる
    if((state==='attack'||state==='hit') && path===set[fb].idle) return null;
  }
  return {path, flip};
}
/* 方向セットを持たないモンスター用: 攻撃/被弾の差し替えポーズ1枚 */
const mpose=(k)=>({attack:`assets/t_m2_${k}_attack.png`,hit:`assets/t_m2_${k}_hit.png`});
